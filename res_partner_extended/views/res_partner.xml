        <record id="view_partner_property_form_ekara" model="ir.ui.view">
            <field name="name">res.partner.property.form.ekara</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">

                <!-- LDC Details -->
                <xpath expr="//group[@name='credit_limits']" position="after">
                    <group string="LDC Details"
                           name="ldc_details"
                           groups="account.group_account_invoice,account.group_account_readonly">
                        <field name="ldc_no"/>
                        <field name="ldc_expiry_date" required="ldc_no"/>
                    </group>

                    <group string="TDS Applicable"
                           name="tds_check"
                           groups="account.group_account_invoice,account.group_account_readonly">
                        <field name="tds_applicable"/>
                        <field name="tds_limit_amount_partner"
                               invisible="not tds_applicable"
                               required="tds_applicable"/>
                        <field name="tds_tax_id"
                               string="TDS Tax"
                               options="{'no_open': True, 'no_quick_create':True,'no_create': True}"
                               invisible="not tds_applicable"
                               required="tds_applicable"/>
                    </group>

                    <group string="TCS Applicable"
                           name="tcs_check"
                           invisible="country_code != 'IN'"
                           groups="account.group_account_invoice,account.group_account_readonly">
                        <field name="tcs_applicable"/>
                        <field name="tcs_limit_amount_partner"
                               invisible="not tcs_applicable"
                               required="tcs_applicable"/>
                        <!-- <field name="tcs_tax_id"
                               string="TCS Tax"
                               options="{'no_open': True, 'no_quick_create':True,'no_create': True}"
                               invisible="not tcs_applicable"
                               required="tcs_applicable"/> -->
                    </group>
                </xpath>

                <!-- Review Log Page -->
                <xpath expr="//page[@name='accounting_disabled']" position="after">
                    <page string="Review Log"
                          name="review_log"
                          readonly="state == 'approve'">

                        <group string="Review Log">
                            <group>
                                <field name="review_lines">
                                    <list editable="bottom"
                                          edit="0"
                                          create="0"
                                          delete="0">
                                        <field name="review_date"/>
                                        <field name="review_on"/>
                                        <field name="review_status"
                                               widget="badge"
                                               decoration-muted="review_status == 'on_review'"
                                               decoration-success="review_status == 'reviewed'"
                                               decoration-danger="review_status == 'expired'"/>
                                    </list>
                                </field>
                            </group>
                        </group>

                    </page>
                </xpath>

                <!-- Credit Limit in Sale Section -->
                <xpath expr="//group[@name='sale']/field[@name='property_inbound_payment_method_line_id']"
                       position="after">

                    <label for="use_partner_credit_limit"
                           string="Credit Limit"/>

                    <div class="o_row">
                        <field name="use_partner_credit_limit"/>
                        <field name="credit_limit"
                               class="oe_inline"
                               invisible="not use_partner_credit_limit"/>
                    </div>

                </xpath>

            </field>
        </record>

        <record id="view_partner_approval_tree" model="ir.ui.view">
        <field name="name">res.partner.approval.list</field>
        <field name="model">res.partner.approval</field>
        <field name="arch" type="xml">
            <list string="Contact Approvals">
                <field name="partner_id"/>
                <field name="request_note"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_partner_approval_form" model="ir.ui.view">
        <field name="name">res.partner.approval.form</field>
        <field name="model">res.partner.approval</field>
        <field name="arch" type="xml">
            <form string="Contact Approval">
                <header>

                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            invisible="state != 'pending'"
                            groups="res_partner_extended.group_contact_admin_access"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'pending'"
                            groups="res_partner_extended.group_contact_admin_access"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['approved','rejected']"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="partner_id" readonly="state != 'draft'"/>
                        <field name="request_note" readonly="state != 'draft'"/>
                        <field name="rejection_reason"
                               readonly="1"
                               invisible="state != 'rejected'"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_partner_approval" model="ir.actions.act_window">
        <field name="name">Contact Change Request</field>
        <field name="res_model">res.partner.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_partner_approval_root"
              name="Contact Approvals"
              parent="contacts.menu_contacts"
              action="action_partner_approval"/>


        <record id="view_reject_wizard_form" model="ir.ui.view">
            <field name="name">reject.wizard.form</field>
            <field name="model">partner.approval.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Reason">
                    <group>
                        <field name="reason" required="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm_reject"
                                string="Confirm Reject"
                                type="object"
                                class="btn-danger"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
