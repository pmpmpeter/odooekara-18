                </xpath>
                <xpath expr="//field[@name='buyer_id']" position="attributes">
                    <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='property_supplier_payment_term_id']" position="attributes">
                    <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//label[@for='receipt_reminder_email']" position="attributes">
                    <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='receipt_reminder_email']" position="attributes">
                    <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='property_purchase_currency_id']" position="attributes">
                    <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='is_vendor']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='buyer_id']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='is_customer']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='property_payment_term_id']" position="attributes">
