<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Cheque print template-->
    <template id="cheque_payment_document">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <t t-foreach="docs" t-as="o">

                <div style="font-weight:bold;margin-top:0px;padding-bottom: 250px;">
                    <!--<t t-set="data" t-value="o.action_print_cheque_payment()"/>-->
                    <div t-attf-style="width:{{o.cheque_format_id.cheque_width}}px; height:{{o.cheque_format_id.cheque_height}}px; font-size:{{o.cheque_format_id.font_size}}px;">
                        <!--Account payee cheque format-->
                        <!--<div t-if="data.get('is_account_payee')">-->
                        <!--    <img src="odoo_print_cheque/static/src/img/accountpay.png" t-attf-style="margin-left:{{a_c_payee_left_margin}}px; margin-top:{{a_c_payee_top_margin}}px; width:{{a_c_payee_width}}px; height:{{a_c_payee_height}}px"/>-->
                        <!--</div>-->
                        <!--Cheque sequence number format-->
                        <div t-attf-style="position: absolute;margin-left:{{o.cheque_format_id.cheque_no_lm}}px; margin-top:{{cheque_no_tm}}px;">
                            <t t-if="o.cheque_format_id.print_cheque_number">
                                <span>
                                    <t t-esc="check_number"/>
                                </span>
                            </t>
                            <t t-else=""/>
                        </div>
                        <!--Cheque date format-->
                        <div t-attf-style="position: absolute;margin-left:{{o.cheque_format_id.date_left_margin}}px; margin-top:{{o.cheque_format_id.date_top_margin}}px; letter-spacing: {{o.cheque_format_id.date_letter_spacing}}em;">
                            <t t-esc="o.date.strftime('%d%m%Y')"/>
                        </div>
                        <!--Partner Name format-->
                        <!--                    <div t-attf-style="width:100%;position: absolute;margin-left:{{o.cheque_format_id.beneficiary_left_margin}}px; margin-top:{{o.cheque_format_id.beneficiary_top_margin}}px;">-->
                        <!--                        <t t-esc="o.partner_id.name"/>-->
                        <!--                    </div>-->
                        <div t-attf-style="width:100%;position: absolute;margin-left:{{o.cheque_format_id.beneficiary_left_margin}}px; margin-top:{{o.cheque_format_id.beneficiary_top_margin}}px;">
                            <!--<t t-esc="o.partner_id.name"/>-->
                            <t t-if="o.partner_id">
                                <t t-if="not o.rtgs_addition">
                                    <t t-esc="o.partner_bank_id.acc_holder_name"/>
                                </t>
                                <t t-else="">
                                    <span>Y/s For NEFT/RTGS</span>
                                    <t t-esc="o.partner_bank_id.acc_holder_name"/>
                                </t>
                            </t>


                        </div>
                        <!-- Amount in words format-->
                        <div t-attf-style="width:100%;position: absolute;margin-left:{{o.cheque_format_id.amount_word_lm}}px; margin-top:{{o.cheque_format_id.amount_word_tm}}px; letter-spacing: {{o.cheque_format_id.amount_word_ls}}em;">
                            <t t-esc="o.check_amount_in_words"/>
                            Only
                        </div>
                        <!--Amount in digits format-->
                        <div t-attf-style="position: absolute;margin-left:{{o.cheque_format_id.amount_digit_lm}}px; margin-top:{{o.cheque_format_id.amount_digit_tm}}px; letter-spacing: {{o.cheque_format_id.amount_digit_ls}}em; font-size:{{o.cheque_format_id.amount_digit_size}}px;">
                            <t t-if="print_currency">
                                <t t-esc="o.currency_id"/>
                            </t>
                            **
                            <t t-esc="'{:,.2f}'.format(abs(o.amount))"/>
                        </div>
                    </div>
                    <!--</t>-->
                </div>


                <div style="margin-top:175px;font-size:14px;padding: 5px; width: 100%;">
                    <div style="font-weight: bold; font-size: 14px; margin-bottom: 5px;">
                        <t t-esc="o.journal_id.bank_id.name"/>
                        -
                        <t t-esc="o.journal_id.bank_account_id.acc_number"/>
                        <span style="margin-left:120px;">NEFT/RTGS PAYMENT INSTRUCTIONS</span>
                        <!--                    <span style="float:right;padding:2px;">Date: <span style="letter-spacing:5px;border: 1px solid #000;padding: 4px;" t-esc="o.date.strftime('%d%m%Y')"/> </span>-->
                        <t t-set="date_str" t-value="o.date.strftime('%d%m%Y')"/>
                        <span style="float:right;padding:2px;">Date:
                            <span>
                                <t t-foreach="list(date_str)" t-as="char">
                                    <span style="display:inline-block; border:1px solid #000; width:18px; height:22px; line-height:22px; text-align:center;">
                                        <t t-esc="char"/>
                                    </span>
                                </t>
                            </span>
                        </span>

                    </div>

                    <table style="font-size:14px;width: 100%;">
                        <tr>
                            <td style="width: 20%; padding: 2px; font-weight: bold;">Debit Account Number:</td>
                            <td style="width: 30%; border: 1px solid #000; padding: 2px;">
                                <div t-esc="o.journal_id.bank_account_id.acc_number"/>
                            </td>
                            <td style="width: 20%; padding: 2px; font-weight: bold;">Amount in Figure (Rs):</td>
                            <td style="width: 30%; border: 1px solid #000; padding: 2px;">
                                <div t-esc="'{:,}'.format(abs(o.amount))"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Amount in Words (Rs):</td>
                            <td colspan="3" style="border: 1px solid #000; padding: 2px;">
                                <t t-esc="o.check_amount_in_words"/>
                                Only
                            </td>
                        </tr>
                        <t t-if="not o.is_internal_transfer">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Account Number:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.partner_bank_id.acc_number"/>
                                </td>
                                <td style="font-weight: bold;">Confirm Beneficiary Account Number:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.partner_bank_id.acc_number"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Account Number:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.acc_number"/>
                                </td>
                                <td style="font-weight: bold;">Confirm Beneficiary Account Number:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.acc_number"/>
                                </td>
                            </tr>
                        </t>

                        <tr>
                            <td style="font-weight: bold;">Beneficiary Name:</td>
                            <td colspan="3" style="border: 1px solid #000; padding: 2px;">
                                <t t-esc="o.partner_bank_id.acc_holder_name"/>
                            </td>
                        </tr>
                        <t t-if="not o.is_internal_transfer">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Bank Name:</td>
                                <td style="border: 1px solid #000; padding: 2px;line-height: 8px; height: 8px;">
                                    <t t-esc="o.partner_bank_id.bank_id.name"/>
                                </td>
                                <td style="font-weight: bold;">Beneficiary Branch IFSC Code:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.partner_bank_id.bank_id.ifsc_code"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Bank Name:</td>
                                <td style="border: 1px solid #000; padding: 2px;line-height: 8px; height: 8px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.bank_id.name"/>
                                </td>
                                <td style="font-weight: bold;">Beneficiary Branch IFSC Code:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.bank_id.ifsc_code"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="not o.is_internal_transfer">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Branch:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.partner_bank_id.bank_id.bank_branch"/>
                                </td>
                                <td style="font-weight: bold;">City:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.partner_bank_id.bank_id.city"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td style="font-weight: bold;">Beneficiary Branch:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.bank_id.bank_branch"/>
                                </td>
                                <td style="font-weight: bold;">City:</td>
                                <td style="border: 1px solid #000; padding: 2px;">
                                    <t t-esc="o.destination_journal_id.bank_account_id.bank_id.city"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                    <p style="font-weight: bold; margin: 5px 0;">I have read and understood the terms and conditions
                        mentioned overleaf:
                    </p>
                    <hr style="margin: 5px 0; border-bottom: 1px solid #000;"/>
                    <p style="font-weight: bold; margin: 5px 0;">
                        As per RBI circular dated October 14, 2010, transfer of funds through electronic mode will be
                        <br/>
                        executed only on the basis of beneficiary's account number and not name.
                        <br/>
                        Purpose of Remittance-
                    </p>
                    <p style="text-align: left; margin: 5px 0;">Sr.No :
                        <span t-if="o.sr_no" t-esc="o.sr_no"/>
                    </p>
                    <p style="text-align: right; font-weight: bold; margin-right: 10px;">Authorised Signatories</p>
                    <br/>
                    <p style="text-align: right; font-weight: bold; margin: 5px 0;">AS per Mode of Operation</p>
                </div>


                <div style="font-size:14px;width: 100%; border: 1px solid #000;">
                    <table style=" font-size:14px;width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 4px; width: 20%; font-weight: bold;">Client Name :</td>
                            <td colspan="3" style="padding: 4px; width: 30%;">
                                <t t-esc="o.partner_id.name"/>
                            </td>
                            <!--<td style="padding: 4px;"/>-->
                            <!--<td style="padding: 4px;"/>-->

                        </tr>
                        <tr>
                            <td style="padding: 4px; font-weight: bold;">Assigned By:</td>
                            <td style="padding: 4px;">
                                <t t-if="o.assigned_by" t-esc="o.assigned_by.name"/>
                            </td>
                            <td style="padding: 4px; width: 35%; font-weight: bold;text-align: right;">Managed By:</td>
                            <td style="padding: 4px; width: 30%;">
                                <t t-if="o.managed_by" t-esc="o.managed_by.name"/>
                            </td>

                        </tr>
                        <tr>
                            <th style="padding: 6px; text-align: left; font-weight: bold; border-top: 1px solid #000;">
                                Modified By
                            </th>
                            <th style="padding: 6px; text-align: left; font-weight: bold; border-top: 1px solid #000;">
                                Modified On
                            </th>
                            <th colspan="2"
                                style="padding: 6px; text-align: center; font-weight: bold; border-top: 1px solid #000;">
                                Comments
                            </th>
                            <!--<th style="padding: 6px; border-top: 1px solid #000;"/>-->

                        </tr>
                        <tr>
                            <td style="padding: 6px; border-top: 1px solid #000;">
                                <t t-esc="o.write_uid.name"/>
                            </td>
                            <td style="padding: 6px; border-top: 1px solid #000;">
                                <t t-esc="o.write_date.strftime('%d-%b-%y %H:%M:%S')"/>
                            </td>
                            <td colspan="2" style="padding: 6px; text-align: center; border-top: 1px solid #000;">
                                <t t-if="o.comments" t-esc="o.comments"/>
                            </td>
                            <!--<td style="padding: 6px; border-top: 1px solid #000;"/>-->
                        </tr>
                    </table>
                </div>


                <div style="font-size:14px;width: 100%; border: 1px solid #000;margin-top:30px;">
                    <table style="font-size:14px;width: 100%;border-collapse: collapse;">
                        <tr>
                            <td style="padding: 4px; width: 20%;">Bank Name:</td>
                            <td colspan="2" style="padding: 4px; width: 45%;">
                                <t t-esc="o.journal_id.bank_id.name"/>
                                -
                                <t t-esc="o.journal_id.bank_account_id.acc_number"/>
                            </td>
                            <!--<td style="width:35%;"/>-->
                            <td style="padding: 4px;text-align: right;">NO:</td>
                            <td style="padding: 4px;">
                                <t t-esc="o.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">Debit A/c No :</td>
                            <td style="padding: 4px;">
                                <t t-esc="o.journal_id.bank_account_id.acc_number"/>
                            </td>
                            <td style="padding: 4px;font-weight: bold;text-align:right;">BANK PAYMENT VOUCHER</td>
                            <td style="padding: 4px; width: 20%;text-align: right;">Date:</td>
                            <td style="padding: 4px; width: 30%;">
                                <t t-esc="o.date.strftime('%d-%b-%y')"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">Cheque/Txn No:</td>
                            <td colsapn="4" style="padding: 4px;">
                                <t t-if="o.cheque_number" t-esc="o.cheque_number"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px; text-align: left; border-top: 1px solid #000;">Paid to:</td>
                            <td colspan="4" style="padding: 6px; text-align: left; border-top: 1px solid #000;">
                                <t t-if="o.partner_id" t-esc="o.partner_id.name"/>
                            </td>
                            <!--<td style="padding: 6px; text-align: left; border-top: 1px solid #000;"/>-->
                            <!--<td style="padding: 6px; text-align: left; border-top: 1px solid #000;"/>-->
                            <!--<td style="padding: 6px; text-align: left; border-top: 1px solid #000;"/>-->
                        </tr>
                        <tr>
                            <td style="padding: 6px;">Towards:</td>
                            <td colspan="4" style="padding: 6px;">
                                <t t-if="o.towards" t-esc="o.towards"/>
                            </td>
                            <!--<td style="padding: 6px;"/>-->
                            <!--<td style="padding: 6px;"/>-->
                            <!--<td style="padding: 6px;"/>-->
                        </tr>
                        <tr>
                            <td style="padding: 6px;">Amount Rs.:</td>
                            <td colspan="4" style="padding: 6px;">
                                <t t-esc="'{:,.2f}'.format(abs(o.amount))"/>
                            </td>
                            <!--<td style="padding: 6px;"/>-->
                            <!--<td style="padding: 6px;"/>-->
                            <!--<td style="padding: 6px;"/>-->
                        </tr>
                        <tr/>
                        <tr>
                            <td style="padding: 6px;">Prepared by :</td>
                            <td colspan="2" style="padding: 6px;">
                                <t t-esc="o.create_uid.name"/>
                            </td>
                            <!--<td style="padding: 6px;"/>-->
                            <td style="padding: 6px;text-align:right;">Authorised by:</td>
                            <td style="padding: 6px;">
                                <t t-if="o.authorised_by" t-esc="o.authorised_by.name"/>
                            </td>
                        </tr>
                        <tr/>
                        <tr/>
                        <tr>
                            <td style="padding: 6px;">Date:</td>
                            <td colspan="2" style="padding: 6px;">
                                <t t-esc="o.create_date.strftime('%d-%b-%y')"/>
                            </td>
                            <!--<td style="padding: 6px;"/>-->
                            <td style="padding-left: 15px;text-align:center;">Date:</td>
                            <td style="padding: 6px;">
                                <t t-if="o.authorised_date" t-esc="o.authorised_date.strftime('%d-%b-%y')"/>
                            </td>
                        </tr>
                    </table>
                </div>

            </t>
        </t>
    </template>
</odoo>
