<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Cheque details format configuration view-->
    <record id="cheque_format_action" model="ir.actions.act_window">
        <field name="name">Check Models</field>
        <field name="res_model">cheque.format</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--Tree view-->
    <record id="cheque_format_view_tree" model="ir.ui.view">
        <field name="name">cheque.format.view.list</field>
        <field name="model">cheque.format</field>
        <field name="arch" type="xml">
            <list string="Check format table">
                <field name="bank_name"/>
                <field name="is_account_payee"/>
            </list>
        </field>
    </record>
    <!--Form view-->
    <record id="cheque_format_view_form" model="ir.ui.view">
        <field name="name">cheque.format.view.form</field>
        <field name="model">cheque.format</field>
        <field name="arch" type="xml">
            <form string="Check format">
                <header>
                    <!--Button for test print-->
                    <button name="action_print_test" type="object"
                            string="Test Print"
                            class="oe_highlight" style="float:left;"/>
                </header>
                <sheet>
                    <group>
                        <!-- Configure bank name-->
                        <group>
                            <field name="is_readonly" invisible="True"/>
                            <field name="bank_name" readonly="is_readonly"/>
                            <field name="font_size" readonly="is_readonly"/>
                        </group>
                        <!-- Configure the cheque size-->
                        <group>
                            <field name="cheque_width" readonly="is_readonly"/>
                            <field name="cheque_height" readonly="is_readonly"/>
                        </group>
                    </group>
                    <!--Configure for the cheque format-->
                    <notebook>
                        <!-- To print account payee-->
                        <page string="Crossed Account Payee cheque Format"
                              name="account_payee_page">
                            <group>
                                <field name="is_account_payee" readonly="is_readonly"/>
                            </group>
                            <group invisible="is_account_payee == False">
                                <field name="a_c_payee_top_margin" readonly="is_readonly"/>
                                <field name="a_c_payee_left_margin" readonly="is_readonly"/>
                                <field name="a_c_payee_width" readonly="is_readonly"/>
                                <field name="a_c_payee_height" readonly="is_readonly"/>
                            </group>
                        </page>
                        <!--To print sequence number-->
                        <page string="Cheque Sequence Number Format"
                              name="cheque_sequence_page">
                            <group>
                                <field name="print_cheque_number" readonly="is_readonly"/>
                            </group>
                            <group invisible = "print_cheque_number == False">
                                <field name="cheque_no_tm" readonly="is_readonly"/>
                                <field name="cheque_no_lm" readonly="is_readonly"/>
                            </group>
                        </page>
                        <!--To print date-->
                        <page string="Date Format" name="date_format_page">
                            <group>
                                <field name="date_remove_slashes" readonly="is_readonly"/>
                                <field name="date_top_margin" readonly="is_readonly"/>
                                <field name="date_left_margin" readonly="is_readonly"/>
                                <field name="date_letter_spacing" readonly="is_readonly"/>
                            </group>
                        </page>
                        <!--To print beneficiary name-->
                        <page string="Beneficiary Format"
                              name="Beneficiary_format_page">
                            <group>
                                <field name="beneficiary_top_margin" readonly="is_readonly"/>
                                <field name="beneficiary_left_margin" readonly="is_readonly"/>
                            </group>
                        </page>
                        <!--To print amount in words-->
                        <page string="Amount in word Format"
                              name="word_format_page">
                            <group>
                                <field name="amount_word_tm" readonly="is_readonly"/>
                                <field name="amount_word_lm" readonly="is_readonly"/>
                                <field name="amount_word_ls" readonly="is_readonly"/>
                            </group>
                        </page>
                        <!--To print amount in digits-->
                        <page string="Amount in digit Format"
                              name="digit_format_page">
                            <group>
                                <field name="print_currency" readonly="is_readonly"/>
                                <field name="amount_digit_tm" readonly="is_readonly"/>
                                <field name="amount_digit_lm" readonly="is_readonly"/>
                                <field name="amount_digit_ls" readonly="is_readonly"/>
                                <field name="amount_digit_size" readonly="is_readonly"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <menuitem
            id="cheque_format_menu"
            name='Configure Cheques'
            parent="account.account_banks_menu"
            sequence="3"
            action="cheque_format_action"/>
</odoo>
