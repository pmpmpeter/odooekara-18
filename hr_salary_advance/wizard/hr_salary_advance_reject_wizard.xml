<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hr_salary_advance_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">Hr Salary Advance Reject Wizard View Form</field>
        <field name="model">hr.salary.advance.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="reject_reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>