<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hr_contract_view_form_inherited" model="ir.ui.view">
        <field name="name">Hr Contract View Form Inherited</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="salary_advance_details" string="Salary Advance Details">
                    <group>
                        <field name="salary_advance_eligible_amount"/>
                        <field name="salary_advance_availed_amount"/>
                        <field name="salary_advance_current_month"/>
                        <field name="salary_advance_status"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>