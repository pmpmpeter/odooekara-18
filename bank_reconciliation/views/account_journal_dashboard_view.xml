<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_dashboard_kanban_view_inherit_account_journal" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.closing.balance</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='JournalBodyBankCash']/div[@id='dashboard_bank_cash_right']" position="inside">
                
                <div class="row" name="bank_closing_balance" t-if="dashboard.bank_closing_balance">
                    <div class="col text-start">
                        <span title="Bank Balance">Bank Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span>
                            <t t-esc="dashboard.bank_closing_balance"/>
                        </span>
                    </div>
                </div>
                <div class="row" name="gl_balance" t-if="dashboard.gl_balance and dashboard.account_balance">
                    <div class="col text-start">
                        <span title="GL Balance">GL Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span>
                            <t t-esc="dashboard.gl_balance"/>
                        </span>
                    </div>
                </div>
            </xpath>


        </field>
    </record>

</odoo>
