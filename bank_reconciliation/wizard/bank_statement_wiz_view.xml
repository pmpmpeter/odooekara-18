<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bank_statement_wiz_tree" model="ir.ui.view">
        <field name="name">bank.statement.list</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
            <list>
                <field name="journal_id"/>
                <field name="account_id"/>
                <field name="date_from" column_invisible='1'/>
                <field name="date_to"/>
                <field name="gl_balance"/>
                <field name="start_bank_balance"/>
                <field name="bank_balance"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'posted'"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bank_statement_wiz" model="ir.ui.view">
        <field name="name">bank.statement.reconciliation</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Reconciliation">
                <header>
                    <button name="action_post" string="Post" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'posted'" class="btn-secondary"/>
                    <button name="action_update_brs" string="Update BRS" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="%(action_view_bank_reconciliation_form_wizard)d" string="Download Report" 
                            type="action" invisible="state != 'posted'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id" readonly="state == 'posted'" required="1" options="{'no_create': True}"/>
                            <field name="account_id" readonly="state == 'posted'" options="{'no_create': True}"/>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_from" invisible='1'/>
                            <field name="date_to" readonly="state == 'posted'"/>
                            <field name="posted_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page id="bank_statement_lines" string="Statement Lines">
                            <field name="statement_lines" nolabel="1" readonly="state == 'posted'">
                                <list create="false" editable="bottom" default_order="date"
                                    decoration-success="(bank_indicator == False)" decoration-danger="(bank_indicator == True)">
                                    <field name="date" readonly="True"/>
                                    <field name="move_id" readonly="True" groups="account.group_account_user"/>
                                    <field name="bank_indicator" column_invisible="1"/>
                                    <field name="name" readonly="True"/>
                                    <field name="counter_part_ledger" readonly="True"/>
                                    <field name="ref" readonly="True"/>
                                    <field name="ref_date" readonly="True"/>
                                    <field name="partner_id" readonly="True"/>
                                    <field name="currency_id" readonly="True" column_invisible="1" />
                                    <field name="date_maturity" readonly="True" column_invisible="1"/>
                                    <field name="statement_date"/>
                                    <field name="amount_currency" readonly="True" groups="base.group_multi_currency" column_invisible="0"/>
                                    <field name="company_currency_id" column_invisible="1" readonly="True"/>
                                    <field name="debit" readonly="True" sum="debit"/>
                                    <field name="credit" readonly="True" sum="credit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="gl_balance"/>
                        <field name="balance_difference" invisible="1"/>
                        <field name="receipts_difference"/>
                        <field name="payments_difference"/>
                        <field name="start_bank_balance" readonly="state == 'posted'"/>
                        <field name="bank_balance"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bank_statement_wiz_filter" model="ir.ui.view">
        <field name="name">bank.statement.select</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
            <search string="Search Move">
                <field name="journal_id" string="Journal"/>
                <field name="account_id"/>
                <field name="date_from" invisible='1'/>
                <field name="date_to"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Journal" name="journal_id" domain="[]" context="{'group_by': 'journal_id'}"/>
                    <filter string="Account" name="account_id" domain="[]" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_bank_statement_wiz" model="ir.actions.act_window">
        <field name="name">Bank Statement Reconciliation</field>
        <field name="res_model">bank.statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_bank_reconciliation_statement" model="ir.actions.act_window">
        <field name="name">Bank Statement Reconciliation</field>
        <field name="res_model">bank.statement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bank_statement_wiz_tree"/>
        <field name="search_view_id" ref="view_bank_statement_wiz_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manual Bank Reconciliation
            </p>
            <p>
                Matching your system transactions with your Bank.
            </p>
        </field>
    </record>

    <!-- <menuitem id="menu_action_bank_reconciliation_new" parent="account.menu_finance_entries_actions" action="action_bank_reconciliation_statement" sequence="26"/> -->
    <menuitem id="menu_action_bank_reconciliation_new" action="action_bank_reconciliation_statement" sequence="26"/>

</odoo>
