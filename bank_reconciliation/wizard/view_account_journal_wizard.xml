<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_journal_wizard_view_form" model="ir.ui.view">
            <field name="name">account.journal.wizard.view.form</field>
            <field name="model">account.journal.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="liquidity_end_date" required="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        <button string="Update" type="object" class="btn btn-primary"  name="action_submit"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="account_journal_wizard_action" model="ir.actions.act_window">
            <field name="name">Account Journal Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.journal.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>