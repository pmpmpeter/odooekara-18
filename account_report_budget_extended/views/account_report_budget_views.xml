<odoo>
    <record id="account_report_budget_form_inherit" model="ir.ui.view">
        <field name="name">account.report.budget.form.inherit</field>
        <field name="model">account.report.budget</field>
        <field name="inherit_id" ref="account_reports.account_report_budget_form"/>
        <field name="arch" type="xml">

            <!-- Header -->
            <xpath expr="//form" position="inside">
                <header>
                    <button name="action_lock" string="Lock" type="object" class="oe_highlight" invisible="state == 'locked'"/>
                    <button name="action_unlock" string="Unlock" type="object" class="oe_highlight" invisible="state != 'locked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="locked" invisible="state != 'locked'"/>
                </header>
            </xpath>

            <!-- Company (hidden) -->
            <xpath expr="//sheet" position="inside">
                <field name="company_id" invisible="1"/>
            </xpath>

            <!-- Additional fields below budget name -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <group>
                        <field name="sequence" readonly="state == 'locked'"/>
                        <field name="budget_type" readonly="state == 'locked'"/>
                    </group>
                    <group>
                        <field name="budget_category" readonly="state == 'locked'"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1" force_save="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Make budget items readonly when locked -->
            <xpath expr="//field[@name='item_ids']" position="attributes">
                <attribute name="readonly">state == 'locked'</attribute>
            </xpath>

            <!-- Chatter -->
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>

        </field>
    </record>

     <record id="account_budget_position_tree_view_extend" model="ir.ui.view">
        <field name="name">account.report.budget.inherit</field>
        <field name="model">account.report.budget</field>
        <field name="inherit_id" ref="account_reports.account_report_budget_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="state" string="Status" invisible="state != 'locked'" widget="badge"/>
            </field>
        </field>
    </record>

</odoo>