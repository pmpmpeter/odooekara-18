<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="email_template_document_approval_request" model="mail.template">
            <field name="name">Document Approval Request</field>
            <field name="model_id" ref="document_access_mixins.model_document_request"/>
            <field name="subject">{{ object.name }} Document Request Approval</field>
            <field name="description">Used for the approval notification of document</field>
            <field name="body_html" type="html">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi,
                    <br/>
                    <br/>
                    Please review the document and take the appropriate action by selecting Approve or Reject.
                    You can access the details here:
                    <br/>
                    <br/>
                    <a style="background-color:#875A7B; padding:8px 16px 8px 16px; text-decoration:none; color:#fff; border-radius:5px" t-attf-href="{{ ctx['URL'] }}">View Request</a>
                    <strong><t t-out="object.name"/></strong>
                </p>
            </field>
        </record>

    </data>
</odoo>