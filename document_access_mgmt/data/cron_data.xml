<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_delete_request_files" model="ir.cron">
            <field name="name">Delete Files Older Than 24 Hours</field>
            <field name="model_id" ref="model_document_request"/>
            <field name="state">code</field>
            <field name="code">model.delete_old_files()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_type">hours</field>
            <field name="interval_number">24</field>
        </record>

          <!-- Scheduled Action to run the cron job daily -->
        <record id="ir_cron_document_request_expiry" model="ir.cron">
            <field name="name">Document Expiry State Updater</field>
            <field name="model_id" ref="model_document_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_move_to_expired_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>

</odoo>
