<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_document_item">
		<t t-call="web.external_layout">

	    	<div class="page">
		    	<div class="oe_structure"/>
                <t t-if="env.context.get('generation_date', False)">
                <div class="row" t-if="report_type == 'pdf'" style="height:0px; width:100%; margin-left:10%; margin-top:10%;">
                    <div class="col-6" name="watermark">
                        <t t-if="env.context.get('is_watermark', False)">
                            <span style="-webkit-transform:rotate(-45deg); color:green; font-size:6em; text-align:center; position:absolute; opacity:0.2;">
                                <t t-esc="env.context.get('watermark_content', False)"/>
                        </span>
                        </t>

                    </div>
                </div>
            </t>
		    	<h2 class="text-center">
                    <span t-field="doc.name"/>
	            </h2>
                <br/><br/>
                <div class="row">
                    <div class="col-4"><strong>Description</strong></div>
                </div>
                <br/>
                <div class="row">
                    <div class="col-auto"><span t-field="doc.description"/></div>
                </div>
                <br/><br/>
                <div style="border: 1px solid #000; padding: 15px; width: 100%; display: flex; flex-direction: column;">
                    <div class="row">
                        <div class="col-8" style="display: flex; justify-content: space-between; align-items: center;">
                            <t t-if="env.context.get('purpose', False)">
                                <div style="width:80%;">
                                    <strong>Purpose:</strong>
                                    <p>
                                       <span t-esc="env.context.get('purpose', False)"/>
                                    </p>
                                </div>
                            </t>
                        </div>

                        <div class="col-4">
                            <div>
                                <strong>Date:</strong>
                            </div>
                            <br/>
                            <div style="display: flex; justify-content: flex-end; height: 60px;">
                                <strong>Signature:</strong>
                            </div>
                        </div>

                    </div>

                </div>


            </div>
        </t>
    </template>

    <template id="document_item_report">
        <t t-call="web.html_container">
       		<t t-foreach="docs" t-as="doc">
		    	<t t-call="document_access_mgmt.report_document_item" t-lang="lang"/>
      		</t>
        </t>
    </template>

