<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_item_tree_view" model="ir.ui.view">
        <field name="name">document.item.list</field>
        <field name="model">document.item</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="document_item_form_view" model="ir.ui.view">
        <field name="name">document.item.form</field>
        <field name="model">document.item</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Documents">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Transaction Document"/>
                        </h1>
                    </div>
                    <group>
                        <field name="doc_available_hours" />
                    </group>
                    <field name="description"  placeholder="Description..." widget="html"/>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

    <record id="document_items_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">document.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Documents
          </p>
        </field>
    </record>
</odoo>
