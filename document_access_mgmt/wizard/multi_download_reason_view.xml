<?xml version="1.0" encoding="utf-8"?>
<data>
    <odoo>
    <!-- Wizard Form View -->
    <record id="view_download_reason_wizard_form" model="ir.ui.view">
        <field name="name">download.reason.wizard.form</field>
        <field name="model">download.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Dowload Reason">
                <group>
                    <field name="reason" placeholder="This Document has been Download Multiple times, so Kindly enter the reason for Downloading the document" />
                </group>
                <footer>
                    <button name="action_get_reason" 
                            type="object" 
                            string="Confirm" 
                            class="oe_highlight" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_download_reason_wizard" model="ir.actions.act_window">
        <field name="name">Download Reason</field>
        <field name="res_model">download.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

    
</data>