<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_document_access_mgmt">
            <field name="name">Document Access Management</field>
            <field name="description">Helps you manage your document access</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_document_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="document_access_mgmt.module_category_document_access_mgmt"/>
        </record>

        <record id="group_document_manager" model="res.groups">
            <field name="name">Administration</field>
            <field name="category_id" ref="document_access_mgmt.module_category_document_access_mgmt"/>
            <field name="implied_ids" eval="[(4, ref('document_access_mgmt.group_document_user'))]"/>
        </record>

        <!-- <record id="document_user_rule" model="ir.rule">
            <field name="name">User can only see their own records</field>
            <field name="model_id" ref="model_document_item"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_document_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record> -->

        <record id="document_manager_rule" model="ir.rule">
            <field name="name">Manager can see all records</field>
            <field name="model_id" ref="model_document_item"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- No restriction, managers see all records -->
            <field name="groups" eval="[(4, ref('group_document_manager'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="document_request_user_read_rule" model="ir.rule">
            <field name="name">User can read their own records</field>
            <field name="model_id" ref="model_document_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_document_user'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/> <!-- Read is always allowed -->
        </record>

        <record id="document_request_user_write_rule" model="ir.rule">
            <field name="name">User can edit their own draft records</field>
            <field name="model_id" ref="model_document_request"/>
            <field name="domain_force">[('user_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('group_document_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/> <!-- Write only allowed in draft -->
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="0"/>
        </record>


        <record id="document_request_manager_rule" model="ir.rule">
            <field name="name">Manager can see all records</field>
            <field name="model_id" ref="model_document_request"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- No restriction, managers see all records -->
            <field name="groups" eval="[(4, ref('group_document_manager'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
    </data>
</odoo>