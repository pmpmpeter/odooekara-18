<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_type_master_form" model="ir.ui.view">
            <field name="name">purchase.orders.type.form</field>
            <field name="model">purchase.orders.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="purchase_type_master_tree" model="ir.ui.view">
            <field name="name">purchase.orders.type.list</field>
            <field name="model">purchase.orders.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="action_category_purchase_type" model="ir.actions.act_window">
            <field name="name">Purchase Type</field>
            <field name="res_model">purchase.orders.type</field>
            <field name="view_mode">list,form</field>
            <field name="context"></field>
            <field name="domain">[]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create new purchase Type
              </p>
            </field>
        </record>

        <menuitem id="menu_action_category_purchase_category" action="action_category_purchase_type" parent="purchase.menu_purchase_config"
         sequence="20"/>


    </data>
</odoo>
