<?xml version="1.0" encoding="utf-8"?>
<data>
    <odoo>
    <!-- Form View for Purchase Order Approval Wizard -->
    <record id="view_purchase_order_approval_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.approval.wizard.form</field>
        <field name="model">purchase.order.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Capture Approval Reason">
                <group>
                    <field name="approval_reason" placeholder="Enter the reason for approval"/>
                </group>
                <footer>
                    <button string="Submit" type="object" name="submit_reason" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_purchase_order_approval_wizard" model="ir.actions.act_window">
        <field name="name">Approval Reason</field>
        <field name="res_model">purchase.order.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
</data>