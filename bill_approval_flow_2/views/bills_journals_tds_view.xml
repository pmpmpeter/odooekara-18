<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated "Bills & Journals" list for one approval (bills and the payments'
         own journal entries together), with a combined TDS column. Standalone (not
         inherited from the shared account.move list), so it cannot affect any other
         screen in the system. Wired in via action_view_bills' own 'views' key. -->
    <record id="view_bill_approval_bills_journals_list" model="ir.ui.view">
        <field name="name">bill.approval.bills.journals.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Bills &amp; Journals" create="0">
                <field name="name"/>
                <field name="partner_id" string="Vendor"/>
                <field name="invoice_date" string="Bill Date"/>
                <field name="invoice_date_due" string="Due Date"/>
                <field name="approval_untaxed_display" string="Taxable Billed" sum="Total"/>
                <field name="approval_gst_display" string="GST Billed" sum="Total"/>
                <field name="tds_display_amount" string="TDS" sum="Total"/>
                <field name="approval_paid_taxable_display" string="Taxable Paid (cash)" sum="Total"/>
                <field name="approval_paid_gst_display" string="GST Paid (cash)" sum="Total"/>
                <field name="payment_state" string="Payment"/>
                <field name="state" string="Status" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
