<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_exit_interview_form_pdf_A4" model="report.paperformat">
        <field name="name">Exit Interview - Separation</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
    </record>

    <record id="exit_interview_form_report" model="ir.actions.report">
        <field name="name">Exit Interview Print</field>
        <field name="model">exit.interview</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.print_exit_interview_form</field>
        <field name="report_file">hr_resignation.print_exit_interview_form</field>
        <field name="paperformat_id" ref="hr_resignation.paperformat_exit_interview_form_pdf_A4"/>
        <field name="print_report_name">'Exit Interview - %s' % (object.employee_id.name)</field>
        <field name="binding_model_id" ref="hr_resignation.model_exit_interview"/>
        <field name="binding_type">report</field>
    </record>

    <template id="print_exit_interview_form">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <p>
                            <!--                            <table align="right"-->
                            <!--                                   style="width: 50%; border-collapse: collapse;  font-size: 14px; ">-->
                            <!--                                <tr>-->
                            <!--                                    <th style="text-align: center; font-weight: bold; padding: 10px;">Solis/HR/PROCESS-->
                            <!--                                        /7.5-->
                            <!--                                    </th>-->
