<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_clearance_form_pdf_A4" model="report.paperformat">
        <field name="name">Clearance Form - Separation</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
    </record>

    <record id="clearance_form_report" model="ir.actions.report">
        <field name="name">Clearance form Report</field>
        <field name="model">clearance.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.print_clearance_form</field>
        <field name="report_file">hr_resignation.print_clearance_form</field>
        <field name="paperformat_id" ref="hr_resignation.paperformat_clearance_form_pdf_A4"/>
        <field name="print_report_name">'%s - Clearance Form' % (object.employee_id.name)</field>
        <field name="binding_model_id" ref="hr_resignation.model_clearance_form"/>
        <field name="binding_type">report</field>
    </record>

