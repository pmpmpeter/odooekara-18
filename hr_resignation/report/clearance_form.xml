                        <h4 style="text-align: center; font-weight: bold;">CLEARANCE FORM</h4>
                        <br/>
                        <br/>
                        <!--                        <br/>-->
                        <div>
                            <table style="width: 100%; font-size: 16px; border-collapse: collapse; border:1px solid white;">
                                <tr>
                                    <td style="vertical-align: top; width: 50%; padding-right: 10px;">
                                        <p>
                                            <b>Name of Employee:</b>
                                            <span style="margin-left: 10px;">
                                                <t t-esc="doc.employee_id.name"/>
                                            </span>
                                        </p>
                                        <p>
                                            <b>Designation:</b>
                                            <span style="margin-left: 10px;">
                                                <t t-esc="doc.designation_id.name"/>
                                            </span>
                                        </p>
                                        <p>
                                            <b>Date of Joining:</b>
                                            <span style="margin-left: 10px;">
                                                <t t-esc="doc.date_of_joining"/>
                                            </span>
                                        </p>
                                    </td>
                                    <td style="vertical-align: top; width: 50%; padding-left: 10px;">
                                        <p>
                                            <b>Department:</b>
                                            <span style="margin-left: 10px;">
                                                <t t-esc="doc.department_id.name"/>
                                            </span>
                                        </p>
                                        <p>
                                            <b>Last Working Day:</b>
                                            <span style="margin-left: 10px;">
                                                <t t-esc="doc.last_working_day"/>
                                            </span>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <br/>
                        <!--                        <br/>-->
                        <!--                        <br/>-->


                        <h5 style="text-align: center; font-weight: bold;">Handing Over Assets</h5>
                        <br/>
                        <br/>
                        <t t-name="hr_resignation.report_asset_return_template">
                            <table style="width: 100%; border-collapse: collapse; border: 1px solid black;">
                                <tr style="border: 1px solid black;">
                                    <td style="text-align: center; font-weight: bold; padding: 10px; width: 20%; border: 1px solid black;">
                                        <b>Asset</b>
                                    </td>
                                    <td style="text-align: center; font-weight: bold; padding: 10px; width: 20%; border: 1px solid black;">
                                        <b>Returned To</b>
                                    </td>
                                    <td style="text-align: center; font-weight: bold; padding: 10px; width: 40%; border: 1px solid black;">
                                        <b>Remarks</b>
                                    </td>
                                    <td style="text-align: center; font-weight: bold; padding: 10px; width: 20%; border: 1px solid black;">
                                        <b>Signature</b>
                                    </td>
                                </tr>
                                <t t-foreach="doc.asset_ids" t-as="asset">
                                    <tr style="border: 1px solid black;">
                                        <td style="text-align: center; padding: 5px; border: 1px solid black;">
                                            <t t-esc="dict({
                        'laptop': 'Laptop',
                        'sim_card': 'SIM Card',
                        'mobile_handset': 'Mobile Handset',
                        'ipad': 'iPad',
                        'data_card': 'Data Card/Dongle',
                        'access_card': 'Access Card',
                        'photo_id': 'Photo ID',
                        'system': 'System',
                        'email_gpm': 'Email &amp; GPM - ID/PW',
                        'library_books': 'Library Books'
                    })[asset.asset_type]"/>
                                        </td>
                                        <td style="text-align: center; padding: 5px; border: 1px solid black;">
                                            <t t-esc="asset.returned_to.name"/>
                                        </td>
                                        <td style="text-align: center; padding: 5px; border: 1px solid black;">
                                            <t t-esc="asset.remarks"/>
                                        </td>
                                        <td style="text-align: center; padding: 5px; border: 1px solid black;">
                                            <t t-if="asset.signature">
                                                <img t-att-src="'data:image/png;base64,' + asset.signature.decode('utf-8')"
                                                     style="max-width: 125px;"/>
                                            </t>
                                            <t t-else="">
                                                <span>No signature available</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </t>

                        <br/>
                        <br/>
                        <br/>
                        Any additional details required as per function can be attached with this format on a plain
                        sheet.
