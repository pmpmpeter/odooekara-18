                        <h4 style="text-align: center; font-weight: bold;">Clearance by Function Heads</h4>
                        <br/>
                        <br/>
                        <t t-name="hr_resignation.report_clearance_form_template">
                            <table style="width: 100%; border-collapse: collapse; border: 1px solid black;">
                                <tr style="border: 1px solid black;">
                                    <th style="text-align: center; font-weight: bold; padding: 10px; width: 25%; border: 1px solid black;">
                                        <b>Function</b>
                                    </th>
                                    <th style="text-align: center; font-weight: bold; padding: 10px; width: 50%; border: 1px solid black;">
                                        <b>Remarks</b>
                                    </th>
                                    <th style="text-align: center; font-weight: bold; padding: 10px; width: 25%; border: 1px solid black;">
                                        <b>Signature</b>
                                    </th>
                                </tr>
                                <t t-foreach="doc.function_head_ids" t-as="item">
                                    <tr style="border: 1px solid black;">
                                        <td style="text-align: center; padding: 10px; border: 1px solid black;">
                                            <t t-esc="dict({
                        'business_head': 'Business Head',
                        'reporting_manager': 'Reporting Manager',
                        'admin': 'Admin',
                        'it': 'IT',
                        'accounts': 'Accounts',
                        'corporate_hr': 'Corporate HR',
                    })[item.function]"/>
                                        </td>
                                        <td style="text-align: center; padding: 10px; border: 1px solid black;">
                                            <t t-esc="item.remarks"/>
                                        </td>
                                        <td style="text-align: center; padding: 10px; border: 1px solid black;">
                                            <t t-if="item.signature">
                                                <img t-att-src="'data:image/png;base64,' + item.signature.decode('utf-8')"
                                                     style="max-width: 125px;"/>
                                            </t>
                                            <t t-else="">
                                                <span>No signature available</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </t>


                        <br/>
