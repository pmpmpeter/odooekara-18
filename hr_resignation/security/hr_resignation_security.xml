<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_rule_hr_resignation_company" model="ir.rule">
        <field name="name">Separation: Multi Company</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ir_rule_exit_interview_company" model="ir.rule">
        <field name="name">Exit Interview: Multi Company</field>
        <field name="model_id" ref="hr_resignation.model_exit_interview"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ir_rule_clearance_form_company" model="ir.rule">
        <field name="name">Clearance Form: Multi Company</field>
        <field name="model_id" ref="hr_resignation.model_clearance_form"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>


    <!--    Manager permission to view all record   -->
    <record id="hr_resignation_rule_hr_manager" model="ir.rule">
        <field name="name">Employee Separation Manager</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>

    <!--To view their own record only-->
    <record id="hr_resignation_rule_hr_user" model="ir.rule">
        <field name="name">Employee Separation User</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="hr_resignation_rule_user" model="ir.rule">
        <field name="name">Employee Separation User</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Access to their own contracts-->
    <record id="hr_contract_rule_user" model="ir.rule">
        <field name="name">Employee: Own Contracts</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- Exit Interview Access-->
    <record id="exit_interview_hr_manager" model="ir.rule">
        <field name="name">Exit Interview User</field>
        <field name="model_id" ref="hr_resignation.model_exit_interview"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="exit_interview_hr_user" model="ir.rule">
        <field name="name">Exit Interview User</field>
        <field name="model_id" ref="hr_resignation.model_exit_interview"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="exit_interview_user" model="ir.rule">
        <field name="name">Exit Interview User</field>
        <field name="model_id" ref="hr_resignation.model_exit_interview"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Clearance Form Access-->
    <record id="clearance_rule_hr_manager" model="ir.rule">
        <field name="name">Clearance Form Manager</field>
        <field name="model_id" ref="hr_resignation.model_clearance_form"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="clearance_rule_hr_user" model="ir.rule">
        <field name="name">Clearance Form User</field>
        <field name="model_id" ref="hr_resignation.model_clearance_form"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="clearance_rule_user" model="ir.rule">
        <field name="name">Clearance Form basic User</field>
        <field name="model_id" ref="hr_resignation.model_clearance_form"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
