<?xml version="1.0" ?>
<odoo noupdate="0">
    <!--Email template -->
    <record id="email_template_resignation_approved_request" model="mail.template">
        <field name="name">Resignation Approval: Approved Case</field>
        <field name="model_id" ref="multi_level_approval.model_multi_approval"/>
        <field name="email_to">{{ object.origin_ref.employee_id.work_email }}</field>
        <field name="email_cc">{{ object.origin_ref.coach_id.work_email }},{{object.origin_ref.employee_parent_id.work_email }}
        </field>
        <field name="subject">Resignation Approved by HR</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.origin_ref.employee_id.name or ''"/>,
                    <br/>
                    <br/>
                    <p>Your resignation request has been approved by HR. Below are the details:</p>
                    <ul>
                        <li>
                            <strong>Last Working Day:</strong>
                            <t t-esc="object.origin_ref.hr_approved_reliving_date"/>
                        </li>
                        <li>
                            <strong>Reason for Resignation:</strong>
                            <t t-esc="object.origin_ref.reason"/>
                        </li>
                    </ul>
                    <p>Please ensure all your tasks are handed over and settled before your last working day.</p>
                    <p>We appreciate your contributions to the organization and wish you success in your future
                        endeavors.
                    </p>
                    <p>Best regards,</p>
                    <p>
                        <t t-esc="object.origin_ref.coach_id.name"/>
                        (HR)
                    </p>
                </p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="email_template_approved_request" model="mail.template">
        <field name="name">Approval: approved case</field>
        <field name="model_id" ref="multi_level_approval.model_multi_approval"/>
        <field name="partner_to">{{ object.user_id.partner_id.id }}</field>
        <field
                name="subject"
        >Your request {{ object.display_name }} has been approved
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear<t t-out="object.user_id.name or ''"/>,
                    <br/>
                    <br/>
                    Your request
                    <t t-out="object.display_name or ''"/>
                    has been approved on
                    <t
                            t-out="format_date(object.complete_date) or ''"
                    />
                    <br/>
                    <br/>
                    Regards,
                </p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
    <record id="email_template_refused_request" model="mail.template">
        <field name="name">Approval: refused case</field>
        <field name="model_id" ref="multi_level_approval.model_multi_approval"/>
        <field name="partner_to">{{ object.user_id.partner_id.id }}</field>
        <field
                name="subject"
        >Your request {{ object.display_name }} has been refused
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear<t t-out="object.user_id.name or ''"/>,
                    <br/>
                    <br/>
                    Your request
                    <t t-out="object.display_name or ''"/>
                    has been refused on
                    <t
                            t-out="format_date(object.complete_date) or ''"
                    />
                    <br/>
                    <br/>
                    Regards,
                </p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
