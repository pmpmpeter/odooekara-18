<odoo>

    <record id="hr_employee_form_encashment" model="ir.ui.view">
        <field name="name">hr.employee.form.encashment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_encashments" type="object" class="oe_stat_button" icon="fa-money">
                    <field name="encashment_count" widget="statinfo" string="Encashments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>