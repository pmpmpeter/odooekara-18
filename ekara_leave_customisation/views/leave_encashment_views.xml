<odoo>

    <record id="leave_encashment_form" model="ir.ui.view">
        <field name="name">leave.encashment.form</field>
        <field name="model">leave.encashment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" groups="hr.group_hr_manager" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" groups="hr.group_hr_manager" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="request_date"/>
                            <field name="year"/>
                        </group>

                        <group>
                            <field name="encash_days"/>
                            <field name="eligible_balance" readonly="1"/>
                            <field name="eligibility_message" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="leave_encashment_tree" model="ir.ui.view">
        <field name="name">leave.encashment.list</field>
        <field name="model">leave.encashment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="encash_days"/>
                <field name="eligible_balance"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <record id="leave_encashment_action" model="ir.actions.act_window">
        <field name="name">Leave Encashment</field>
        <field name="res_model">leave.encashment</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_leave_encashment"
              parent="hr_holidays.menu_hr_holidays_root"
              action="leave_encashment_action"
              sequence="50"/>

</odoo>