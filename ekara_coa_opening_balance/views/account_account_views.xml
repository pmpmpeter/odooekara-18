<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restore the Odoo 17 style Opening Debit / Opening Credit columns.
         Values are computed for the currently active company (Odoo 18 shared CoA). -->
    <record id="view_account_list_opening_balance" model="ir.ui.view">
        <field name="name">account.account.list.opening.balance</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reconcile']" position="after">
                <field name="opening_debit" optional="show" sum="Total Opening Debit"/>
                <field name="opening_credit" optional="show" sum="Total Opening Credit"/>
            </xpath>
        </field>
    </record>
</odoo>
