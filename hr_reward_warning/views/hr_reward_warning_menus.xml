<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--  Root menu for hr.announcement.   -->
    <menuitem id="hr_announcement_menu_root"
              name="Announcements"
              parent="hr.menu_hr_employee_payroll"
              groups="hr.group_hr_user,hr.group_hr_manager"
              sequence="10"/>

    <!--  HR Announcements Menu  -->
    <menuitem id="hr_announcement_menu_view_announcements"
              name="Announcements"
              action="hr_announcement_action"
              parent="hr_announcement_menu_root"
              groups="hr.group_hr_user,hr.group_hr_manager"
              sequence="1"/>

    <menuitem id="hr_announcement_menu_view_announcements_new"
              name="Announcements"
              action="hr_announcement_action"
              web_icon="hr_reward_warning,static/description/a_icon.png"
              groups="hr.group_hr_user,hr.group_hr_manager"
              sequence="1"/>

    <record id="hr_announcement_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [])]"/>
    </record>

    <record id="hr_announcement_menu_view_announcements" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [])]"/>
    </record>

</odoo>
