<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="accounting_report_balance_view_monthly_tree" model="ir.ui.view">
            <field name="name">accounting.balance.report.list</field>
            <field name="model">accounting.balance.report</field>
            <field name="arch" type="xml">
                <list>
                    <field name="account_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </list>
            </field>
        </record>


        <record id="accounting_report_balance_view_monthly_report" model="ir.ui.view">
            <field name="name">Account Balance</field>
            <field name="model">accounting.balance.report</field>
            <field name="arch" type="xml">
                <form string="Financial Report">
                    <header>
                        <button name="check_report" string="PRINT PDF" type="object" class="oe_highlight" invisible="1"/>
                        <button name="account_ledger_balance_report" string="PRINT XLSX" type="object" class="oe_highlight" invisible="1"/>
                    </header>
                    <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                                name="action_open_journal_items_total"
                                icon="fa-asterisk"
                                invisible="journal_items_count == 0"
                                type="object"
                                class="oe_inline oe_stat_button">
                            <field name="journal_items_count" widget="statinfo" string="Journal Item(s)"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True,'no_edit':True}"/>
                            <field name="company_id" invisible='1'/>
                        </group>
                        <group>
                            <field name="current_fiscal_year" invisible='1'/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="partner_id"  invisible="1"/>
                            <field name="partner_ids" widget="many2many_tags" options="{'no_create': True,'no_edit':True}"/>
                        </group>
                        <group>
                            <field name="analytic_account_id" invisible="1"/>
                            <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True,'no_edit':True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="journal_ids" widget="many2many_tags" options="{'no_create': True,'no_edit':True}"/>
                    </group>
                    <button name="update_ledger_report" string="Update" type="object" class="oe_highlight oe_right"/>
                        <field name="monthly_report_lines" nolabel="1">
                            <list string="Monthly Report" editable="bottom" create='false' delete='false'>
                                <field name="wizard_id" column_invisible="1"/>
                                <field name="partner_id" column_invisible="1"/>
                                <field name="analytic_account_id" column_invisible="1"/>
                                <field name="partner_ids" widget="many2many_tags" column_invisible="1"/>
                                <field name="analytic_account_ids" widget="many2many_tags" column_invisible="1"/>
                                <field name="journal_ids" widget="many2many_tags" column_invisible="1"/>
                                <field name="account_id" column_invisible="1"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="month"/>
                                <field name="year"/>
                                <field name="op_balance" readonly='1'/>
                                <field name="debit" readonly='1' sum='debit'/>
                                <field name="credit" readonly='1' sum='credit'/>
                                <field name="balance" readonly='1'/>
                                <field name="cl_balance" readonly='1'/>
                                <field name="company_id" column_invisible='1'/>
                                <field name="journal_items_count" readonly='1' string='Items'/>
                                <button type='object' icon="fa-eye" name='action_open_journal_items' invisible="journal_items_count == 0"/>
                                <button type='object' icon="fa-download" title="Download" name='check_monthly_report' invisible="journal_items_count == 0"/>
                            </list>
                        </field>
                
                </sheet>
                </form>
            </field>
        </record>

        <record id="view_account_balance_monthly_report_filter" model="ir.ui.view">
            <field name="name">accounting.balance.report.filter</field>
            <field name="model">accounting.balance.report</field>
            <field name="arch" type="xml">
                <search string="account_id">
                    <field name="account_id" string="Report"/>
                    <group expand="0" string="Group By...">
                        <filter name="group_account_id" string="Report" domain="[]"
                                context="{'group_by':'account_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_view_account_balance_monthly_report1">
            <field name="name">Ledger Monthly Report</field>
            <field name="res_model">accounting.balance.report</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">list,form,search</field>
            <field name="context">{}</field>
            <field name="search_view_id" ref="view_account_balance_monthly_report_filter"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create a new report...
                </p>
            </field>
        </record>

        <record id="action_account_balance_report" model="ir.actions.act_window">
            <field name="name">Account Balance</field>
            <field name="res_model">accounting.balance.report</field>
            <field name="type">ir.actions.act_window</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="view_id" ref="accounting_report_balance_view_monthly_report"/>
            <field name="target">new</field>
        </record>

        <menuitem
                name="Account Ledger Balance"
                action="action_view_account_balance_monthly_report1"
                id="menu_account_balance_monthly_report_view"
                parent="account.menu_finance_reports"
                sequence="11"/>

        <!-- <menuitem 
            name="Account Balance View" 
            action="action_account_balance_report" 
            id="menu_account_balance_monthly_report_view2" 
            parent="account.menu_finance_reports" 
            sequence="12"/>     
 -->
    </data>
</odoo>
