<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="project_own_assigned_tasks_rule">
        <field name="name">Project/Task: project user: see tasks which are assigned to them or added as a follower</field>
        <field name="model_id" ref="model_project_task"/>
        <field name="domain_force">
            [
        '|','|',
                    ('message_partner_ids', 'in', [user.partner_id.id]),
                    ('user_ids', 'in', user.id),
                    ('project_id.user_id','=',user.id)
            ]
        </field>
    </record>
    <record id="group_project_bill" model="res.groups">
        <field name="name">Task Bill &amp; Payment creation</field>
    </record>
</odoo>
