<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="project_task_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">Project Task Assign Wizard Form View</field>
        <field name="model">project.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="task_id" invisible="1"/>
                        <field name="assign_to_user_id" string="Assign To"/>
                        <field name="assign_reason" string="Reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="oe_highlight"/>
                    <button name="cancel" string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>