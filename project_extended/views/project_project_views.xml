<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_edit_project_view_form" model="ir.ui.view">
        <field name="name">Inherit Project Form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name='alias_contact' position='after'>
            <field name='is_a_master' />
            <field name='department_id' options="{'no_create': True, 'no_open': True}" />
            </field>
            <xpath expr="//sheet/div" position="before">
                <widget name="web_ribbon" title="Master" invisible="is_a_master != True" />
            </xpath>
        </field>
    </record>

   
    <record id="task_type_tree_inherited_inherited" model="ir.ui.view">
        <field name="name">Task Type Tree view inherited</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_tree_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_done_stage"/>
            </xpath>
        </field>
    </record>

    <record id="task_type_edit_inherited" model="ir.ui.view">
        <field name="name">Project Task Type Edit Form View inherited</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_done_stage"/>
            </xpath>
        </field>
    </record>


    <record id="inherit_edit_project_view_tree" model="ir.ui.view">
        <field name="name">Inherit Project Tree</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="date_of_notice"/>
                <field name="last_date"/>
                <field name="create_date"/>
            </xpath>
        </field>
    </record>
    <record id="project.open_view_project_all" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">project.project</field>
            <field name="domain">[('is_legal_notice', '=', False)]</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="project.view_project_kanban"/>
            <field name="search_view_id" ref="project.view_project_project_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No projects found. Let's create one!
                </p>
                <p>
                    Create projects to organize your tasks. Define a different workflow for each project.
                </p>
            </field>
        </record>

   <record id='edit_project_view_form_extend' model='ir.ui.view'>
        <field name="name">project.project.form.extend</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form string="Project" class="o_form_project_project" js_class="form_description_expander">
                    <field name="company_id" invisible="1"/>
                    <header>
                        <button name="%(project.project_share_wizard_action)d" string="Share Read-only" type="action" class="oe_highlight" groups="project.group_project_manager"
                        invisible="privacy_visibility != 'portal'" context="{'default_access_mode': 'read', 'dialog_size': 'medium'}" data-hotkey="r"/>
                        <button name="%(project.project_share_wizard_action)d" string="Share Editable" type="action" class="oe_highlight" groups="project.group_project_manager"
                        invisible="privacy_visibility != 'portal'" context="{'default_access_mode': 'edit', 'dialog_size': 'medium'}" data-hotkey="e"/>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" groups="project.group_project_stages" domain="[('company_id', 'in', (company_id, False))]"/>
                    </header>
                <sheet string="Project">
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button class="oe_stat_button" type="object" name="action_view_tasks" icon="fa-tasks">
                            <field string="Tasks" name="open_task_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="project_update_all_action" type="object" groups="project.group_project_user">
                            <field name="last_update_color" invisible="1"/>
                            <div class="o_stat_info">
                                <field name="last_update_status" readonly="1" widget="status_with_color" status_label="Project Status"/>
                            </div>
                        </button>
                        <!-- To Do: remove me in master -->
                        <button class="oe_stat_button o_project_not_clickable" disabled="disabled" groups="!project.group_project_manager" invisible="1">
                            <div>
                                <field name="last_update_color" invisible="1"/>
                                <field name="last_update_status" readonly="1" widget="status_with_color" status_label="Project Status"/>
                            </div>
                        </button>
                       
                        <button class="oe_stat_button" name="action_open_documents" type="object" icon="fa-file-text-o" invisible="document_count == 0">
                            <div>
                                <field name="document_count" widget="statinfo" string="Documents"/>
                            </div>
                        </button>

                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="is_favorite" nolabel="1" widget="boolean_favorite" class="me-2"/>
                            <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" invisible="not is_legal_notice" placeholder="Legal Notice...ABC"/>
                            <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" invisible="not is_statuory_notice" placeholder="Statutory Notice ...ABC"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_done" invisible="1"/>
                            <field name="label_tasks" string="Name of the Tasks" placeholder="e.g. Tasks" readonly="is_done"/>
                            <field name="partner_id" widget="res_partner_many2one" readonly="is_done"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="is_done"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="is_done"/>
                            <field name="create_uid" invisible="not is_legal_notice" readonly="1"/>
                            <field name="create_date" invisible="not is_legal_notice" readonly="1"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="user_id" string="Project Manager" widget="many2one_avatar_user" readonly="not active or is_done" domain="[('share', '=', False)]" options="{'no_quick_create': True}"/>
                            <field name="date_start" string="Planned Date" widget="daterange" options='{"end_date_field": "date", "always_range": "1"}' required="date_start or date" readonly="is_done"/>
                            <field name="date" invisible="1" required="date_start"/>
                            <field name="is_legal_notice" invisible="1"/>
                            <field name="is_statuory_notice" invisible="1"/>
                            <field name="date_of_notice" invisible="not (is_legal_notice or is_statuory_notice)" readonly="is_done"/>
                            <field name="last_date" invisible="not (is_legal_notice or is_statuory_notice)" readonly="is_done"/>
                            <field name="first_reminder" invisible="not (is_legal_notice or is_statuory_notice)" readonly="is_done"/>
                            <field name="second_reminder" invisible="not (is_legal_notice or is_statuory_notice)" readonly="is_done"/>
                            <field name="first_reminder_date" invisible="1"/>
                            <field name="second_reminder_date" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description" readonly="is_done">
                            <field name="description" options="{'resizable': false}" placeholder="Project description..."/>
                        </page>
                        <page name="settings" string="Settings" readonly="is_done">
                            <group>
                                <group>
                                    
                                    <field name="privacy_visibility" widget="radio"/>
                                    <span colspan="2" class="text-muted o_row ps-1" invisible="access_instruction_message == ''">
                                        <i class="fa fa-lightbulb-o"/>&amp;nbsp;<field class="d-inline" name="access_instruction_message" nolabel="1"/>
                                    </span>
                                    <span colspan="2" class="text-muted o_row ps-1" invisible="privacy_visibility_warning == ''">
                                        <i class="fa fa-warning"/>&amp;nbsp;<field class="d-inline" name="privacy_visibility_warning" nolabel="1"/>
                                    </span>
                                </group>
                                <group>
                                    <div name="alias_def" colspan="2" class="pb-2">
                                        <!-- Always display the whole alias in edit mode. It depends in read only -->
                                        <!-- Need to add alias_id in view for getting alias_domain_id by default -->
                                        <field name="alias_id" invisible="1"/>
                                        <label for="alias_name" class="fw-bold o_form_label" string="Create tasks by sending an email to"/>
                                        <field name="alias_email" class="oe_read_only d-inline" widget="email" readonly="1" invisible="not alias_name" />
                                        <span class="oe_edit_only o_row">
                                            <field name="alias_name"/>@
                                            <field name="alias_domain_id" class="oe_inline" placeholder="e.g. domain.com"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                        </span>
                                    </div>
                                    <!-- the alias contact must appear when the user start typing and it must disappear
                                        when the string is deleted. -->
                                    <field name="alias_contact" class="oe_inline" string="Accept Emails From"
                                           invisible="not alias_email"/>
                                </group>
                                <group name="extra_settings">
                                </group>
                            </group>
                            <group>
                                <group name="group_tasks_managment" string="Tasks Management" col="1" class="row mt16 o_settings_container" groups="project.group_project_task_dependencies,project.group_project_milestone">
                                    <div>
                                        <setting class="col-lg-12" id="task_dependencies_setting" help="Determine the order in which to perform tasks" groups="project.group_project_task_dependencies">
                                            <field name="allow_task_dependencies"/>
                                        </setting>
                                        <setting class="col-lg-12" id="project_milestone_setting" help="Track major progress points that must be reached to achieve success" groups="project.group_project_milestone">
                                            <field name="allow_milestones"/>
                                        </setting>
                                    </div>
                                </group>
                                <group name="group_time_managment" string="Time Management" invisible="1" col="1" class="row mt16 o_settings_container"/>
                                <group name="group_documents_analytics" string="Analytics" col="1" class="row mt16 o_settings_container">
                                    <div>
                                        <setting class="col-lg-12" name="analytic_div" help="Get customer feedback and evaluate the performance of your employees" groups="project.group_project_rating">
                                            <field name="rating_active"/>
                                            <div class="mt16" invisible="not rating_active">
                                                <span class="text-muted o_row ps-1 pb-3">Send a rating request:</span>
                                                <field name="rating_status" widget="radio" class="o_row"/>
                                                <div  invisible="rating_status != 'periodic'"  required="rating_status == 'periodic'">
                                                    <label for="rating_status_period" string="Frequency"/>
                                                    <field class="mx-3 w-auto" name="rating_status_period"/>
                                                </div>
                                                <span colspan="2" class="text-muted o_row ps-1">
                                                    <i class="fa fa-lightbulb-o pe-2"/>
                                                    <span invisible="rating_status == 'periodic'">A rating request will be sent as soon as the task reaches a stage on which a Rating Email Template is defined.</span>
                                                    <span invisible="rating_status == 'stage'">Rating requests will be sent as long as the task remains in a stage on which a Rating Email Template is defined.</span>
                                                </span>
                                                <div class="content-group">
                                                    <div class="mt8">
                                                        <button name="%(project.open_task_type_form_domain)d" context="{'project_id':id}" icon="oi-arrow-right" type="action" string="Set a Rating Email Template on Stages" class="btn-link"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </setting>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
                </form>
            </xpath>
        </field>
    </record>

    <record id="view_project_tree_legal_satutaury_notice" model="ir.ui.view">
        <field name="name">project.project.list.legal.notice</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="department_id" column_invisible="context.get('is_legal_notice_option')"/>
                <field name="partner_id" string="Customer / Vendor" column_invisible="context.get('is_statuory_notice_option')"/>
                <field name="date_of_notice"/>
                <field name="last_date"/>
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="user_id" string="Created By"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="open_create_project_action_extend" model="ir.actions.act_window">
        <field name="name">Legal Notice Management</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'is_legal_notice_option': True}</field>
        <field name="domain">[('is_legal_notice', '=', True)]</field>
        <field name="view_id" ref="project_extended.view_project_tree_legal_satutaury_notice"/>
    </record>

    <record id="open_create_project_statuory_action" model="ir.actions.act_window">
        <field name="name">Statutory Notice Management</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'is_statuory_notice_option': True}</field>
        <field name="domain">[('is_statuory_notice', '=', True)]</field>
        <field name="view_id" ref="project_extended.view_project_tree_legal_satutaury_notice"/>
    </record>

    <menuitem id="open_create_project_menu" name="Notice Management" sequence="13"
              parent="account.menu_finance_entries"/>

    <menuitem id="legal_notice_management_menu" name="Legal Notice Management" sequence="1"
              parent="project_extended.open_create_project_menu" action="open_create_project_action_extend"/>
    <menuitem id="statuory_notice_management_menu" name="Statutory Notice Management" sequence="2"
              parent="project_extended.open_create_project_menu" action="open_create_project_statuory_action"/>

</odoo>
