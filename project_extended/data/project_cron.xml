<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_send_legal_notice_reminder" model="ir.cron">
        <field name="name">Send Notice Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.send_reminder()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_send_recurrence_reminder" model="ir.cron">
        <field name="name">Recurrence Reminder</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model.send_recurring_reminder()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_create_recurring_task" model="ir.cron">
        <field name="name">Create Recurring Task</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_inverse_state()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>


        <record id="cron_check_expired_tasks_recurring" model="ir.cron">
        <field name="name">Recurring Task Expiration Scheduler</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model.check_expired_tasks_recurring()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
