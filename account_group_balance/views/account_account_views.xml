<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_group_balance" model="ir.ui.view">
        <field name="name">account.account.form.group.balance</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='account.action_move_line_select']" position="after">
                <button name="action_open_group_balance" type="object" class="oe_stat_button" icon="fa-building" invisible="group_company_count &lt;= 1">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="group_balance"/>
                        </span>
                        <span class="o_stat_text">
                            Group Balance
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>