                        <page string="Employee Development Plan" groups="hr_extended.group_hr_recruitment_director,hr_extended.group_hr_payslip_admin">
                            <field name="development_plan_ids">
                                <list editable="bottom">
                                    <field name="action" string="Action"/>
                                    <field name="timeline" string="Time Line"/>
                                    <field name="by_whom" string="By Whom"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                    <field name="remarks" string="Remarks"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="action" string="Action"/>
                                        <field name="timeline" string="Time Line"/>
                                        <field name="by_whom" string="By Whom"
                                               options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                        <field name="remarks" string="Remarks"/>
                                    </group>
                                </form>
                            </field>
                            <group>
                                <field name="employee_signature_dev"
                                       options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"
