                            </group>
                        </page>
                        <page string="Review Comments" groups="hr_extended.group_hr_recruitment_director,hr_extended.group_hr_payslip_admin" invisible="is_employee == True">
                            <field name="goal_review_comments">
                                <list editable="bottom">
                                    <field name="commented_by"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                    <field name="comments"/>
                                    <field name="commented_date"/>
                                    <field name="need_response_from"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assessment KRA" groups="hr_extended.group_hr_recruitment_director,hr_extended.group_hr_payslip_admin">
                            <field name="assessment_kra_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name" string="KRA" readonly="1"/>
                                    <field name="weightage" string="Weightage (%)" readonly="1"/>
                                    <field name="employee_rating" string="Employee's Rating"/>
                                    <field name="appraiser_rating" string="Appraiser's Rating"
                                           readonly="not parent.is_appraisal_manager"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="appraiser_overall_rating" string="Appraiser’s Overall Rating"
                                           groups="hr_extended.group_hr_recruitment_director"/>
                                    <field name="appraiser_remarks" string="Appraiser’s Remarks"
                                           readonly="not is_appraisal_manager"/>
                                </group>
                                <group>
                                    <field name="employee_signature"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"
                                           string="Employee’s Signature"/>
                                    <field name="reporting_manager_signature" readonly="not is_appraisal_manager"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"
                                           string="Reporting Manager’s Signature"/>
                                    <field name="reviewer_signature" readonly="not is_appraisal_manager"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"
                                           string="Reviewer’s Signature"/>
                                </group>
                            </group>
                        </page>
