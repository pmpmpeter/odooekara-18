<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_rule_self_rating_company" model="ir.rule">
        <field name="name">Performance Review: Multi Company</field>
        <field name="model_id" ref="hr_appraisal_extended.model_self_rating"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ir_rule_hr_pip_company" model="ir.rule">
        <field name="name">Performance Improvement Plan: Multi Company</field>
        <field name="model_id" ref="hr_appraisal_extended.model_hr_pip"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ir_rule_three_performance_company" model="ir.rule">
        <field name="name">360 Performance Review: Multi Company</field>
        <field name="model_id" ref="hr_appraisal_extended.model_threeperformance_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!--To view their own record only-->
    <record id="performance_review_rule_user" model="ir.rule">
        <field name="name">Performance Review - Candidate</field>
        <field name="model_id" ref="hr_appraisal_extended.model_self_rating"/>
        <field name="domain_force">['|','&amp;',('employee_id.user_id','=',user.id),('is_performance_record','=',True),('reporting_to_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!--HR To view their own record only-->
    <record id="performance_review_rule_hr" model="ir.rule">
        <field name="name">Performance Review HR</field>
        <field name="model_id" ref="hr_appraisal_extended.model_self_rating"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_user'))]"/>
    </record>
    <!--Manager To view their own record only-->
    <record id="performance_review_rule_manager" model="ir.rule">
        <field name="name">Performance Review Manager</field>
        <field name="model_id" ref="hr_appraisal_extended.model_self_rating"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_manager'))]"/>
    </record>

    <record id="group_appraisal_access_view" model="res.groups">
        <field name="name">Appraisal Access</field>
    </record>

    <record id="threeperformance_review_rule_user" model="ir.rule">
        <field name="name">360 Performance Review - Candidate</field>
        <field name="model_id" ref="hr_appraisal_extended.model_threeperformance_review"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="threeperformance_review_rule_hr" model="ir.rule">
        <field name="name">360 Performance Review HR</field>
        <field name="model_id" ref="hr_appraisal_extended.model_threeperformance_review"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_user'))]"/>
    </record>

    <record id="threeperformance_review_rule_manager" model="ir.rule">
        <field name="name">360 Performance Review Manager</field>
        <field name="model_id" ref="hr_appraisal_extended.model_threeperformance_review"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_manager'))]"/>
    </record>

    <!--To view their own record only-->
    <record id="performance_impvt_rule_user" model="ir.rule">
        <field name="name">Performance Improvement - Candidate</field>
        <field name="model_id" ref="hr_appraisal_extended.model_hr_pip"/>
        <field name="domain_force">['|',('employee_id.user_id','=',user.id),('supervisor_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!--HR To view their own record only-->
    <record id="performance_impvt_rule_hr" model="ir.rule">
        <field name="name">Performance Improvement HR</field>
        <field name="model_id" ref="hr_appraisal_extended.model_hr_pip"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_user'))]"/>
    </record>
    <!--Manager To view their own record only-->
    <record id="performance_impvt_rule_manager" model="ir.rule">
        <field name="name">Performance Improvement Manager</field>
        <field name="model_id" ref="hr_appraisal_extended.model_hr_pip"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_manager'))]"/>
    </record>
</odoo>
