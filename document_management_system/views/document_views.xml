<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action Window -->
    <record id="document_workflow_action" model="ir.actions.act_window">
        <field name="name">Document Handling</field>
        <field name="res_model">document.workflow</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tree View -->
    <record id="view_document_workflow_tree" model="ir.ui.view">
        <field name="name">document.workflow.list</field>
        <field name="model">document.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_document_workflow_form" model="ir.ui.view">
        <field name="name">document.workflow.form</field>
        <field name="model">document.workflow</field>
        <field name="arch" type="xml">
            <form string="Handle Document">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="documents_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Document Handling">
                            <notebook>
                                <page string="Documents">
                                    <field name="attachment_ids">
                                        <list string="Documents" create="true" delete="true">
                                            <field name="file_name"/>
                                            <field name="file_data" filename="file_name" widget="download"/>
                                        </list>
                                        <form>
                                            <sheet>
                                                <group>
                                                    <group>
                                                        <field name="file_data" filename="file_name" widget="download"/>
                                                    </group>
                                                    <group>
                                                        <field name="file_name" required="1"/>
                                                    </group>
                                                </group>
                                            </sheet>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                            <notebook>
                                <page string="Document History">
                                    <field name="document_history" editable="top">
                                        <list create="True" delete="False">
                                            <field name="document_workflow_id"/>
                                            <field name="partner_id" />
                                            <field name="submitted_by"/>
                                            <field name="submitted_date"/>
                                            <field name="submitted_to"/>
                                            <field name="received_by"/>
                                            <field name="received_date"/>
                                            <field name="status"/>
                                            <field name="show_scrap" column_invisible="1"/>
                                            <field name="show_store" column_invisible="1"/>
                                            <field name="show_requested" column_invisible="1"/>
                                            <field name="show_received" column_invisible="1"/>

                                            <button name="action_request_approval"
                                                    type="object"
                                                    string="Submit for Acceptance"
                                                    invisible="status not in ['draft','requested'] or show_requested == False"
                                                    class="btn-info"/>

                                            <button name="action_mark_stored"
                                                    type="object"
                                                    string="Store"
                                                    invisible="status != 'done' or show_store == False"
                                                    class="btn-primary"/>

                                            <button name="action_mark_scrap"
                                                    type="object"
                                                    string="Scrap"
                                                    invisible="status != 'done' or show_scrap == False"
                                                    class="btn-warning"/>

                                            <button name="action_mark_done"
                                                    type="object"
                                                    string="Received"
                                                    invisible="status != 'waiting_approval' or show_received == False"
                                                    class="btn-success"/>
                                        </list>
                                        <form>
                                            <sheet>
                                                <group>
                                                    <field name="partner_id" options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                                    <field name="submitted_by"/>
                                                    <field name="submitted_to"/>
                                                    <field name="received_by"/>
                                                    <field name="status"/>
                                                </group>
                                            </sheet>
                                            <chatter/>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_document_history_tree" model="ir.ui.view">
        <field name="name">document.history.list</field>
        <field name="model">document.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="document_workflow_id"/>
                <field name="partner_id"/>
                <field name="submitted_by"/>
                <field name="submitted_date"/>
                <field name="submitted_to"/>
                <field name="received_by"/>
                <field name="received_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_document_history_form" model="ir.ui.view">
        <field name="name">document.history.form</field>
        <field name="model">document.history</field>
        <field name="arch" type="xml">
            <form string="Document History" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="document_workflow_id"/>
                            <field name="partner_id"/>
                            <field name="submitted_by"/>
                            <field name="submitted_date"/>
                            <field name="submitted_to"/>
                        </group>
                        <group>
                            <field name="received_by"/>
                            <field name="received_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_history_pivot" model="ir.ui.view">
        <field name="name">document.history.pivot</field>
        <field name="model">document.history</field>
        <field name="arch" type="xml">
            <pivot string="Document History Analysis">
                <field name="status" type="col"/>
                <field name="document_workflow_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_document_history_search" model="ir.ui.view">
        <field name="name">document.history.search</field>
        <field name="model">document.history</field>
        <field name="arch" type="xml">
            <search string="Document History">
<!--                <field name="name"/>-->
                <field name="submitted_by"/>
                <field name="submitted_to"/>
                <field name="received_by"/>

                <filter name="filter_requested" string="Requested" domain="[('status', '=', 'requested')]"/>
                <filter name="filter_waiting_approval" string="Waiting For Approval" domain="[('status', '=', 'waiting_approval')]"/>
                <filter name="filter_scrapped" string="Scrapped" domain="[('status', '=', 'scrapped')]"/>
                <filter name="filter_stored" string="Stored" domain="[('status', '=', 'stored')]"/>
                <filter name="filter_done" string="Done" domain="[('status', '=', 'done')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_submitted_by" string="Submitted By" context="{'group_by': 'submitted_by'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_received_by" string="Received By" context="{'group_by': 'received_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="document_history_action" model="ir.actions.act_window">
        <field name="name">Document History</field>
        <field name="res_model">document.history</field>
        <field name="view_mode">list,form,pivot,search</field>
    </record>

    <menuitem id="menu_document_workflow_main"
              name="Handle Documents"
              parent="document_access_mgmt.menu_document_access_mgmt"
              sequence="10" />

    <menuitem id="menu_document_workflow_sub"
              name="Handle Document"
              parent="document_management_system.menu_document_workflow_main"
              action="document_workflow_action"
              sequence="1" />

    <menuitem id="menu_document_workflow"
              name="Documents History"
              parent="document_management_system.menu_document_workflow_main"
              action="document_history_action"
              sequence="2" />

</odoo>
