<odoo>
    <data>

        <record id="view_grievance_management_filter" model="ir.ui.view">
            <field name="name">grievance.management.search</field>
            <field name="model">grievance.management</field>
            <field name="arch" type="xml">
                <search string="Search Activities">
                    <filter string="My Request" name="my_request"
                            domain="['|',('employee_id.user_id','=',uid),('manager_id.user_id','=',uid)]"/>
                    <separator/>
                    <filter string="Draft" name="show_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submit" name="show_submit" domain="[('state', '=', 'submit')]"/>
                    <separator/>
                    <filter string="Satisfied" name="show_satisfied" domain="[('state', '=', 'satisfied')]"/>
                    <filter string="UnSatisfied" name="show_unsatisfied" domain="[('state', '=', 'un_satisfied')]"/>
                    <separator/>
                    <filter string="Create Date" name="filter_create_date" date="create_date"/>

                    <field name="employee_id" string="Employee Name"/>
                    <field name="manager_id" string="Manager Name"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_by_employee"
                                context="{'group_by':'employee_id'}"/>
                        <filter string="Manager" name="group_by_manager"
                                context="{'group_by':'manager_id'}"/>
                        <separator/>
                        <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="grievance_management_tree_view">
            <field name="name">grievance_management_tree_view</field>
            <field name="model">grievance.management</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="company_id"/>
                    <field name="state" widget='badge' decoration-info="state == 'submit'"
                           decoration-success="state =='satisfied'"/>
                </list>
            </field>
        </record>

        <record id="grievance_management_form_view" model="ir.ui.view">
            <field name="name">grievance_management_form</field>
            <field name="model">grievance.management</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit_to_manager" string="Submit" type="object"
                                class="oe_highlight" groups="hr.group_hr_user"
                                invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" groups="hr.group_hr_user"
                                invisible="state in ('draft','submit','satisfied')"/>
                        <button name="send_mail_to_employee" string="Send Mail" type="object" class="oe_highlight" groups="hr.group_hr_user"
                                invisible="not resolution or not date_timeline"/>
                        <button name="action_satisfied" string="Satisfied" type="object" class="oe_highlight" groups="hr.group_hr_user"
                                invisible="not resolution or not date_timeline or state not in ('un_satisfied','submit')"/>
                        <button name="action_un_satisfied" string="UnSatisfied" type="object" class="oe_highlight" groups="hr.group_hr_user"
                                invisible="not resolution or not date_timeline or state not in ('submit')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,satisfied"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" string="Employee"
                                    name="action_open_grievance_employee" icon="fa-user" invisible="state in ('draft')">
                            </button>
                        </div>
                        <label for="name" invisible="name == False"/>
                        <h1>
                            <field name="name" invisible="name == False" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state not in ('draft')"
                                       options="{'no_open':True, 'no_create_edit':True, 'no_create': True, 'no_quick_create':True}"
                                       required="True"/>
                                <field name="manager_id" readonly="state not in ('draft')"
                                       options="{'no_open':True, 'no_create_edit':True, 'no_create': True, 'no_quick_create':True}"
                                       required="True"/>
                                <field name="create_date"/>
                            </group>
                            <group>
                                <field name="subject" readonly="state not in ('draft')" required="True"/>
                                <field name="type" readonly="state not in ('draft')" required="True"
                                       options="{'no_open':True, 'no_create_edit':True,'no_create': True, 'no_quick_create':True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" required="True"
                                       placeholder="Enter the description about the Grievance here......"
                                       readonly="state not in ('draft')"/>
                            </page>
                            <page string="Resolution">
                                <group>
                                    <group>
                                        <!-- <field name="is_manager" invisible="1"/>
                                             <field name="date_timeline" readonly="not is_manager or state in ('satisfied')"/>
                                        -->
                                        <field name="date_timeline" readonly="state in ('satisfied')"/>
                                        <field name="representative_id"
                                               options="{'no_open': True, 'no_create_edit':True, 'no_create': True, 'no_quick_create':True}"
                                               readonly="state in ('satisfied')"/>
                                        <field name="resolution" readonly="state in ('satisfied')"/>
                                    </group>
                                    <group>
                                        <field name="unsatisfied" invisible="1"/>
                                        <field name="management_representative_id"
                                               options="{'no_open': True, 'no_create_edit':True, 'no_create': True, 'no_quick_create':True}"
                                               invisible="not unsatisfied"
                                               readonly="state in ('satisfied')"/>
                                        <field name="management_resolution" invisible="not unsatisfied"
                                               readonly="state in ('satisfied')"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="grievance_management_action">
            <field name="name">Grievance Management</field>
            <field name="res_model">grievance.management</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_my_request': 1}</field>
            <field name="search_view_id" ref="view_grievance_management_filter"/>
        </record>

        <menuitem id="grievance_management_menu" name="Grievance"
                  groups="base.group_user" parent="hr.menu_hr_employee_payroll"
                  sequence="12"/>

        <menuitem id="employee_grievance_management_menu"
                  parent="grievance_management.grievance_management_menu" name="Grievance Request"
                  action="grievance_management_action" groups="base.group_user"
                  sequence="1"/>

    </data>
</odoo>
