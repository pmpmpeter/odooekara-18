<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Grievance Type Master -->
        <record id="grievance_type_names_view_tree" model="ir.ui.view">
            <field name="model">grievance.type.names</field>
            <field name="arch" type="xml">
                <list string="Grievance Type" editable="bottom" duplicate="0">
                    <field name="sequence" widget="handle"/>
                    <field name="name" required="1"/>
                    <field name="code" groups="base.group_no_one"/>
                    <field name="respective_hod_id" required="1"
                           options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                    <field name="company_id" required="1"
                           options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="grievance_type_names_view_form" model="ir.ui.view">
            <field name="model">grievance.type.names</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" groups="base.group_no_one"/>
                            <field name="respective_hod_id" required="1"
                                   options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                            <field name="company_id" required="1"
                                   options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                            <field name="active"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_grievance_type_search" model="ir.ui.view">
            <field name="name">Grievance Type Search</field>
            <field name="model">grievance.type.names</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <field name="name" string="Name"/>
                </search>
            </field>
        </record>

        <record id="grievance_type_names_action" model="ir.actions.act_window">
            <field name="name">Grievance Types</field>
            <field name="res_model">grievance.type.names</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="view_grievance_type_search"/>
            <field name="target">current</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Grievance Type Names
                </p>
            </field>
        </record>

        <menuitem id="menu_grievance_configuration" name="Grievance Configuration"
                  parent="hr.menu_human_resources_configuration"
                  sequence="4"
                  groups="hr.group_hr_manager"/>

        <menuitem id="menu_grievance_type_names" name="Grievance Types"
                  parent="grievance_management.menu_grievance_configuration"
                  action="grievance_type_names_action" sequence="2"/>
    </data>
</odoo>
