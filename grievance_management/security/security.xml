<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_rule_grievance_management_company" model="ir.rule">
        <field name="name">Grievance Management: Multi Company</field>
        <field name="model_id" ref="grievance_management.model_grievance_management"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

     <record id="ir_rule_grievance_type_config_company" model="ir.rule">
        <field name="name">Grievance Type Configuration: Multi Company</field>
        <field name="model_id" ref="grievance_management.model_grievance_type_names"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="grievance_management_see_own_records" model="ir.rule">
        <field name="name">See Own Grievances</field>
        <field name="model_id" ref="grievance_management.model_grievance_management"/>
        <field name="domain_force">['|',('employee_id.user_id', '=', user.id),('manager_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="grievance_management_see_all_records_user" model="ir.rule">
        <field name="name">See all Grievances - User</field>
        <field name="model_id" ref="grievance_management.model_grievance_management"/>
        <field name="domain_force">[(1 ,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="grievance_management_see_all_records" model="ir.rule">
        <field name="name">See all Grievances</field>
        <field name="model_id" ref="grievance_management.model_grievance_management"/>
        <field name="domain_force">[(1 ,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>
