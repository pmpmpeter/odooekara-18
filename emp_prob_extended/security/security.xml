<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_probation">
        <field name="name">Employee Probation</field>
        <field name="description">Category for Employee Probation</field>
    </record>

    <record id="group_employee_probation_user" model="res.groups">
        <field name="name">Probation - User</field>
        <field name="category_id" ref="emp_prob_extended.module_category_probation"/>
    </record>

    <record id="group_employee_probation_supervisor" model="res.groups">
        <field name="name">Probation - Supervisor</field>
        <field name="category_id" ref="emp_prob_extended.module_category_probation"/>
        <field name="implied_ids"
               eval="[(4, ref('emp_prob_extended.group_employee_probation_user'))]"/>
    </record>

    <record id="group_employee_probation_manager" model="res.groups">
        <field name="name">Probation - Manager</field>
        <field name="category_id" ref="emp_prob_extended.module_category_probation"/>
        <field name="implied_ids"
               eval="[(4, ref('emp_prob_extended.group_employee_probation_supervisor'))]"/>
    </record>

    <!--Record rules for Employee Probation -->
    <record id="ir_rule_employee_probation_company" model="ir.rule">
        <field name="name">Employee Probation: Multi Company</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="employee_probation_rule_base_user" model="ir.rule">
        <field name="name">Employee Probation</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="employee_probation_rule_user" model="ir.rule">
        <field name="name">Employee Probation - User</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_user'))]"/>
    </record>

    <record id="employee_probation_rule_supervisor" model="ir.rule">
        <field name="name">Employee Probation - Supervisor</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="domain_force">[('parent_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_supervisor'))]"/>
    </record>

    <record id="employee_probation_rule_manager" model="ir.rule">
        <field name="name">Employee Probation - Manager</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_manager'))]"/>
    </record>

    <!--Record rules for Employee Probation Review Form -->
    <record id="ir_rule_employee_probation_review_company" model="ir.rule">
        <field name="name">Employee Probation: Multi Company</field>
        <field name="model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="employee_probation_review_form_rule_base_user" model="ir.rule">
        <field name="name">Employee Probation Review Form</field>
        <field name="model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="employee_probation_review_form_rule_user" model="ir.rule">
        <field name="name">Employee Probation Review Form - User</field>
        <field name="model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_user'))]"/>
    </record>

    <record id="employee_probation_review_form_rule_supervisor" model="ir.rule">
        <field name="name">Employee Probation Review Form - Supervisor</field>
        <field name="model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="domain_force">[('reporting_manager_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_supervisor'))]"/>
    </record>

    <record id="employee_probation_review_form_rule_manager" model="ir.rule">
        <field name="name">Employee Probation Review Form - Manager</field>
        <field name="model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('emp_prob_extended.group_employee_probation_manager'))]"/>
    </record>
</odoo>
