                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Efficiency</td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Attendance</td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
