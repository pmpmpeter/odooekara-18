<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_probation_form_pdf_A4" model="report.paperformat">
        <field name="name">Probation Form</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
    </record>
    <record id="report_probation_review_template" model="ir.actions.report">
        <field name="name">Probation Review</field>
        <field name="model">prob.review.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">emp_prob_extended.print_report_probation_review_form</field>
        <field name="report_file">emp_prob_extended.print_report_probation_review_form</field>
        <field name="paperformat_id" ref="emp_prob_extended.paperformat_probation_form_pdf_A4"/>
        <field name="print_report_name">'%s - Review Form' % (object.employee_id.name)</field>
        <field name="binding_model_id" ref="emp_prob_extended.model_prob_review_form"/>
        <field name="binding_type">report</field>
    </record>


    <template id="print_report_probation_review_form">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <!--page1-->
                <div style="margin-left: 25px; margin-right: 25px;" class="page">
                    <h5 style="text-align: center; font-weight: bold; text-decoration: underline;">PROBATION REVIEW
                        FORM
                    </h5>
                    <P>Probation Record</P>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; text-align: left;">
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Employee name:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.employee_id.name"/>
                            </td>
                        </tr>
                        <!-- Second Row -->
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;width: 50%;">Job Title:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.job_title_id.name"/>
                                <!--                                <select style="width: 100%; padding: 4px;">-->
                                <!--                                    <option value="">Select...</option>-->
                                <!--                                </select>-->
                            </td>
                        </tr>
                        <!-- Additional Rows -->
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Grade:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.grade"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Department / Section:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.department_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Date of Joining:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.date_of_joining"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Reporting Manager Name and
                                Designation:
                            </td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.reporting_manager_id.name"/>
                                <t></t>
                                <t t-esc="doc.reporting_manager_designation_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px; ">Date Due</td>
                            <td style="border: 1px solid black; padding: 8px; ">Please select Date when completed</td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">3-month review:</td>
                            <td style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.three_month_review_due"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.three_month_review_completed"/>
                            </td>

                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">6-month review:</td>
                            <td style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.six_month_review_due"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.six_month_review_completed"/>
                            </td>

                        </tr>
                    </table>

                    <div>
                        <br/>
                        <br/>
                        <h5>
                            <U>PART 1 – First review (3 months from Date of Joining)</U>
                        </h5>
                        <P>To be completed by the Reporting Manager in discussion with the employee.</P>
                    </div>
                    <br/>
                    <br/>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; text-align: left;">
