                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" style="border: 1px solid black; padding: 8px; height: 100px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px;">
                                            The employee may provide any comments about their experience of the
                                            probationary process here.
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px;">
                                            <div style="margin: 0; padding: 0;">
                                                <t t-esc="doc.employee_comment"/>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; height:50px;">Should the
                                employee’s
                                probationary period be extended?
                            </td>
                            <td colspan="3" style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.emp_probation_extend"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" style="border: 1px solid black; padding: 8px; height: 100px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px;">If YES, please provide reasons and, where appropriate,
                                            specify any areas of improvement required and how these
                                            will be monitored.
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px;">
                                            <t t-if="doc.emp_probation_extend == 'yes'">
                                                <t t-esc="doc.emp_probation_extend_reason"/>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Length of the extension (max 3
                                months):
                            </td>
                            <td colspan="5" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.probation_extend_length_"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">New Probation Period completion date:
                            </td>
                            <td colspan="5" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.completion_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Employee’s signature:</td>
                            <td colspan="5" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.employee_signature_fr_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Manager’s signature:</td>
                            <td colspan="5" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.manager_signature_fr_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Date:</td>
                            <td colspan="5" style="border: 1px solid black; padding: 8px;">
                                <t t-esc="doc.date_fr"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" style="border: 1px solid black; padding: 8px; ">The employee has received a
                                letter confirming his satisfactory completion of probation period
                            </td>
                            <td style="border: 1px solid black; padding: 8px; ">
                                <t t-esc="doc.confirm_letter"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </t>    
    </template>
</odoo>
