                                <t t-if="doc.quality_of_work_fr == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work_fr == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work_fr == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.quality_of_work_fr == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Efficiency</td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency_fr == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency_fr == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency_fr == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.efficiency_fr == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Attendance</td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance_fr == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance_fr == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance_fr == 'good'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.attendance_fr == 'excellent'">✔</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Time Keeping</td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.time_keeping_fr == 'improvement_required'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
                                <t t-if="doc.time_keeping_fr == 'satisfactory'">✔</t>
                            </td>
                            <td style="border: 1px solid black; padding: 8px; text-align: center;">
