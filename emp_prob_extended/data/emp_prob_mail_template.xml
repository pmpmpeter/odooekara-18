<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- not using -->
        <!-- using probation_confirmation_letter ekara template -->
    <record id="probation_confirmation_email_template" model="mail.template">
        <field name="name">Probation Confirmation Email</field>
        <field name="model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="subject">Probation Confirmation</field>
        <field name="email_to">${{ object.employee_id.work_email }}</field>
        <field name="partner_to">${{ object.employee_id.id }}</field>
        <field name="body_html">
            <![CDATA[
            <p>Dear <t t-esc="object.employee_id.name"/>,</p>
            <p>Congratulations! Your probation period from <strong><t t-esc="object.start_date"/></strong> to <strong><t t-esc="object.end_date"/></strong> has been successfully completed.</p>
            <p>Please find your Probation Confirmation Letter attached.</p>
            <p>Best regards,</p>
            ]]>
        </field>
    </record>
    </data>
</odoo>
