<?xml version="1.0" ?>
<odoo>

    <record id="group_expense_view" model="res.groups">
        <field name="name">Expense Access</field>
    </record>

    <record id="group_hr_expense_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_human_resources_expenses"/>
        <field name="implied_ids" eval="[(4, ref('hr_expense_extended.group_expense_view'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="hr_expense.group_hr_expense_team_approver" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr_expense_extended.group_hr_expense_user'))]"/>
    </record>

    <record id="group_post_journal_expense" model="res.groups">
        <field name="name">Post Journal Notify</field>
    </record>

</odoo>
