<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Group: Tax Entity Head -->
        <record id="group_tax_entity_head" model="res.groups">
            <field name="name">Tax Entity Head</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Group for Tax Entity Head.</field>
        </record>

        <!-- Group: Tax Entity Director -->
        <record id="group_tax_entity_director" model="res.groups">
            <field name="name">Tax Entity Director</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Group for Tax Entity Director.</field>
        </record>


        <record id="group_compliance_head" model="res.groups">
            <field name="name">Compliance Head</field>
        </record>

        <record id="group_compliance_user" model="res.groups">
            <field name="name">Compliance User</field>
        </record>




        <record id="ir_rule_cash_pool_company" model="ir.rule">
            <field name="name">Cash Pool: Multi Company</field>
            <field name="model_id" ref="model_cash_pool"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="ir_rule_account_subgroup_company" model="ir.rule">
            <field name="name">Account Subgroup: Multi Company</field>
            <field name="model_id" ref="model_account_subgroup"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

 
         <record model="ir.rule" id="cash_requirement_report_rule">
            <field name="name">Cash Requirement Report</field>
            <field name="model_id" ref="accounts_extended.model_cash_requirement_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="group_cancel_accounting_entry" model="res.groups">
                <field name="name">Reset/Cancel Access</field>
        </record>

        
    </data>
</odoo>
