<?xml version="1.0" encoding="utf-8"?>
<data>
    <odoo>
    <!-- Wizard Form View -->
    <record id="view_budget_revision_wizard_form" model="ir.ui.view">
        <field name="name">budget.revision.wizard.form</field>
        <field name="model">budget.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Budget Revision">
                <group>
                    <field name="reason" placeholder="Enter revision reason here..." />
                </group>
                <footer>
                    <button name="action_confirm_revision" 
                            type="object" 
                            string="Confirm" 
                            class="oe_highlight" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_budget_revision_wizard" model="ir.actions.act_window">
        <field name="name">Budget Revision</field>
        <field name="res_model">budget.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

    
</data>