<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_payment_register_form_view_inherit" model="ir.ui.view">
            <field name="name">view.account.payment.form.view</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                 <field name="partner_bank_id" position="after">
                    <field name='utr_number'  required ="payment_type == 'outbound'" invisible ="payment_type != 'outbound'"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
