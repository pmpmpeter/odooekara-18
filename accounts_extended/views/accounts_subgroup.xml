<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_subgroup_form" model="ir.ui.view">
        <field name="name">view.account.subgroup.form</field>
        <field name="model">account.subgroup</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_id" widget="many2many_tags"/>
                        <field name="company_id" readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_subgroup_tree" model="ir.ui.view">
        <field name="name">view.account.subgroup.list</field>
        <field name="model">account.subgroup</field>
        <field name="arch" type="xml">
                <list>
                      <field name="name"/>
                    <field name="company_id"/>
                </list>
        </field>
    </record>

    <record id="action_account_subgroup" model="ir.actions.act_window">
        <field name="name">Account SubGroup</field>
        <field name="res_model">account.subgroup</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Create and configure subgroups.
            </p>
        </field>
    </record>

    <menuitem id="menu_account_subgroup"
              name="Account Subgroup"
              parent="account.menu_finance_configuration"
              action="action_account_subgroup"
              sequence="100"/>
</odoo>