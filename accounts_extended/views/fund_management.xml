<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fund_mangemnt_inherited" model="ir.ui.view">
            <field name="name">fund.management.form</field>
            <field name="model">fund.management</field>
            <field name="inherit_id" ref="account_report_budget_extended.view_fund_mangemnt_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="share_amount_validate" string="Allocate Cash Pool" type="object" invisible="state not in ['draft','inprogress']" class="oe_highlight"/>
                </xpath>
                <xpath expr="//div[@class='oe_title']" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_cash_pool" string="Cash Pool" type="object" class="oe_stat_button"/>
                    </div>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Cash Pool">
                        <field name="cash_pool_line" readonly="state in ['done']">
                            <list editable="bottom" create="1" delete='1'>
                                <field name="version" optional="hide"/>
                                <field name="revision_date" optional="hide" readonly="1" force_save="1"/>
                                <field name="cash_pool" required="1" width='800'
                                       options="{'no_quick_create':True,'no_create': True}" domain="[('state', '=', 'approved'),('invalid_cash_pool', '=', False)]"
                                />
                                <field name="available_balance" readonly="1" decoration-success="1"/>
                                <field name="april_cash_pool" sum="Total"/>
                                <field name="may_cash_pool" sum="Total"/>
                                <field name="june_cash_pool" sum="Total"/>
                                <field name="quarter_1_cash_pool" sum="Total" readonly="1" force_save="1"/>
                                <field name="july_cash_pool" sum="Total"/>
                                <field name="august_cash_pool" sum="Total"/>
                                <field name="september_cash_pool" sum="Total"/>
                                <field name="quarter_2_cash_pool" sum="Total" readonly="1" force_save="1"/>
                                <field name="october_cash_pool" sum="Total"/>
                                <field name="november_cash_pool" sum="Total"/>
                                <field name="december_cash_pool" sum="Total"/>
                                <field name="quarter_3_cash_pool" sum="Total" readonly="1" force_save="1"/>
                                <field name="january_cash_pool" sum="Total"/>
                                <field name="febuary_cash_pool" sum="Total"/>
                                <field name="march_cash_pool" sum="Total"/>
                                <field name="quarter_4_cash_pool" sum="Total" readonly="1" force_save="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        
        
    </data>
</odoo>
