<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_pool_form" model="ir.ui.view">
        <field name="name">cash.pool.form</field>
        <field name="model">cash.pool</field>
        <field name="arch" type="xml">
            <form string="Cash Pool">
                <header>
                    <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'approved'" class="btn-secondary"/>
                    <button name="action_approved" type="object" string="Approve"
                            invisible="state != 'waiting_for_approval'" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                       statusbar_visible="draft,waiting_for_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title" width="100">
                        <h1>
                            <field name="name" placeholder="New" required="1" readonly="state not in ('draft')"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invalid_cash_pool" invisible="1"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="current_balance" readonly="state not in ('draft')"/>
                            <field name="available_balance" readonly="1"/>
                            <field name="manager_id" options="{'no_open': True, 'no_create': True, 'no_quick_create': True}" required="1" invisible="1" readonly="state not in ('draft')"/>
                            <field name="manager" options="{'no_open': True, 'no_create': True, 'no_quick_create': True}" readonly="state not in ('draft')" domain="[('company_ids', 'in', company_id)]"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True, 'no_quick_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fund Lines">
                            <field name="fund_line_ids" readonly="state not in ('draft')">
                                <list editable="bottom" delete="1">
                                    <field name="added_by_id" options="{'no_open': True, 'no_create': True, 'no_quick_create': True}" readonly="1"/>
                                    <field name="amount" readonly="state not in ('draft')"/>
                                    <field name="date" readonly="state not in ('draft')"/>
                                    <field name="approved_by_id" options="{'no_open': True, 'no_create': True, 'no_quick_create': True}" readonly="1" force_save="1"/>
                                    <field name="state" readonly="1"/>
                                    <field name="opening_balance" readonly="1"/>
                                    <field name="closing_balance" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cash_pool_tree" model="ir.ui.view">
        <field name="name">cash.pool.list</field>
        <field name="model">cash.pool</field>
        <field name="arch" type="xml">
            <list string="Cash Pool">
                <field name="name"/>
                <field name="available_balance"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    

    <record id="action_cash_pool" model="ir.actions.act_window">
        <field name="name">Cash Pool</field>
        <field name="res_model">cash.pool</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Create and configure cash pool.
            </p>
        </field>
    </record>

    <menuitem id="menu_cash_pool"
              name="Cash Pool"
              parent="account.menu_finance_configuration"
              action="action_cash_pool"
              sequence="100"/>
</odoo>
