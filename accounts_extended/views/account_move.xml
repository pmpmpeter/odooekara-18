<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_advance_payment_inv_form_inherit" model="ir.ui.view">
            <field name="name">sale.advance.payment.inv.form.inherit</field>
            <field name="model">sale.advance.payment.inv</field>
            <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='advance_payment_method']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    <record id="tds_entry_view_form_inherit_editable" model="ir.ui.view">
            <field name="name">l10n_in.withhold.wizard.view.form.inherit</field>
            <field name="model">l10n_in.withhold.wizard</field>
            <field name="inherit_id" ref="l10n_in_withholding.tds_entry_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='withhold_line_ids']/list/field[@name='amount']" position="replace">
                    <field name="amount" sum="Total Amount" widget="monetary" 
                        options="{'currency_field': 'currency_id'}" readonly='1'/>
                </xpath>
            </field>
        </record>

    <record id="account_active_view_account_move1_search" model="ir.ui.view">
        <field name="name">account.move.active.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[@name='cancel']" position="after">
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

