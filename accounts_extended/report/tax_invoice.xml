<odoo>
    <data>
        <record id="paperformat_accounts_extended_custom_template" model="report.paperformat">
            <field name="name">Rental invoice Template - Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">13</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
        <record id="actions_rental_tax_invoice_template" model="ir.actions.report">
            <field name="name">Rental Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">accounts_extended.report_rental_tax_invoice_template</field>
            <field name="report_file">accounts_extended.report_rental_tax_invoice_template</field>
            <field name="print_report_name">'Rental Invoice - %s' % (object.name)</field>
            <field name="paperformat_id" ref="accounts_extended.paperformat_accounts_extended_custom_template"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
