<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ekara_invoice_template_paperformat" model="report.paperformat">
    <field name="name">Invoice PaperFormat</field>
     <field name="default" eval="True"/>
    <field name="format">A4</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">47.00</field>
    <field name="margin_bottom">25.00</field>
    <field name="margin_left">7</field>
    <field name="margin_right">7</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">45</field>
    <field name="dpi">90</field>
</record>

<record id="print_invoice_template1" model="ir.actions.report">
    <field name="name">Invoice</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">account.report_invoice_with_payments</field>
    <field name="report_file">account.report_invoice_with_payments</field>
    <field name="is_invoice_report">True</field>
    <field name="print_report_name">(object._get_report_base_filename())</field>
    <field name="paperformat_id" ref="accounts_extended.ekara_invoice_template_paperformat"/>
</record>



</odoo>