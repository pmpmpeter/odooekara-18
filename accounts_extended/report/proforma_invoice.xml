<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_proforma_invoice_pdf_A4" model="report.paperformat">
        <field name="name">Proforma Invoice</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>
    <record id="report_proforma_invoice" model="ir.actions.report">
        <field name="name">Proforma Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounts_extended.print_report_proforma_invoice</field>
        <field name="report_file">accounts_extended.print_report_proforma_invoice</field>
        <field name="paperformat_id" ref="accounts_extended.paperformat_proforma_invoice_pdf_A4"/>
        <field name="print_report_name">'RENTAL INVOICE'</field>
        <field name="binding_model_id" ref="accounts_extended.model_account_move"/>
        <field name="binding_type">report</field>
    </record>


    <template id="print_report_proforma_invoice">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <div style="border:1px solid black;">


                <table style="width: 100%; border-collapse: collapse; border-right: 1px solid black; text-align: left;">
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr><tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                    <tr>
                        <th colspan="2" style="border: 1px solid white; text-align:center; padding: 8px; ">RENTAL
                            INVOICE
                        </th>
                         <div style="align-item:center;margin-left:250px;">
                            <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"
                                     style="width:50%;height:75px;  "/>
                         </div>
                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Lessor Name</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; "><t t-esc="doc.company_id.name"/></th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Lessor Address</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-if="doc.company_id.street"/>
                              <t t-esc="doc.company_id.street">,
                              <br/>
                              </t>
                            <t t-if="doc.company_id.street2">
                              <t t-esc="doc.company_id.street2"/>,
                            </t>
                                  <br/>
                            <t t-if="doc.company_id.city">
                              <t t-esc="doc.company_id.city"/>
                                  <br/>
                              </t>
                            <t t-if="doc.company_id.state_id">
                              <t t-esc="doc.company_id.state_id.name"/>,
                              </t>
                            <t t-if="doc.company_id.zip">
                              <t t-esc="doc.company_id.zip"/>,
                              </t>
                            <t t-if="doc.company_id.country_id">
                                <t t-esc="doc.company_id.country_id.name"/>
                            </t>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Invoice No</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; "><t t-esc="doc.name"/></th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Invoice Date</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; "><t t-esc="doc.invoice_date"/></th>

                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>


                    <tr style="margin-top:500px">
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Lessee Name</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-esc="doc.partner_id.name"/>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Lessee Address</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-if="doc.partner_id.street"/>
                              <t t-esc="doc.partner_id.street">,
                              <br/>
                              </t>
                            <t t-if="doc.partner_id.street2">
                              <t t-esc="doc.partner_id.street2"/>,
                            </t>
                                  <br/>
                            <t t-if="doc.partner_id.city">
                              <t t-esc="doc.partner_id.city"/>
                                  <br/>
                              </t>
                            <t t-if="doc.partner_id.state_id">
                              <t t-esc="doc.partner_id.state_id.name"/>,
                              </t>
                            <t t-if="doc.partner_id.zip">
                              <t t-esc="doc.partner_id.zip"/>,
                              </t>
                            <t t-if="doc.partner_id.country_id">
                                <t t-esc="doc.partner_id.country_id.name"/>
                            </t>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">GST Detail</th>
                        <th style="border: 1px solid white; text-align:center; padding: 8px; "></th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">PAN Detail</th>
                        <th style="border: 1px solid white; text-align:center; padding: 8px; "></th>

                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>

                    <tr style="padding-top:500px">
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Rent</th>

                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-foreach="doc.invoice_line_ids" t-as="lines">
                                <t t-esc="lines.product_id.name"/>
                                <br/>
                        </t>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Invoice Period</th>
                        <th style="border: 1px solid white; text-align:center; padding: 8px; "></th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Property Details</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-foreach="doc.invoice_line_ids" t-as="lines">
                                <t t-esc="lines.product_id.name"/>
                                <br/>
                        </t>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">GST SAC Code details</th>
                        <th style="border: 1px solid white; text-align:center; padding: 8px; "></th>

                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>

                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">Bank Account Details</th>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">
                            <t t-if="doc.partner_bank_id">
                                <t t-esc="doc.partner_bank_id.bank_id.name"/><br/>
                                <t t-esc="doc.partner_bank_id.acc_number"/><br/>
                                <t t-if="doc.partner_bank_id.bank_id.ifsc_code">
                                    <span>IFSC Code</span><t t-esc="doc.partner_bank_id.bank_id.ifsc_code"/>
                                    <br/>
                                </t>
                                <t t-if="doc.partner_bank_id.bank_id.bic">
                                    <span>Swift Code</span><t t-esc="doc.partner_bank_id.bank_id.bic"/>
                                    <br/>
                                </t>

                            </t>

                        </th>

                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>

                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">GST</th>
                        <th style="border: 1px solid white; text-align:left;border-bottom:1px solid black; padding: 8px; ">
                            <t t-esc="doc.amount_tax"/>
                        </th>

                    </tr>
                    <tr>
                        <th style="border: 1px solid white; text-align:left; padding: 8px; ">TOTAL</th>
                        <th style="border: 1px solid white; border-bottom:1px double black; text-align:left; padding: 8px; ">
                            <t t-esc="doc.amount_total"/>
                        </th>

                    </tr>
                    <tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr><tr>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                        <td style="border: 1px solid white; text-align:left; padding: 8px; "></td>
                    </tr>
                </table>
                </div>


            </t>
        </t>
    </template>
</odoo>
