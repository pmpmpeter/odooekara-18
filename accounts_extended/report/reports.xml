    <record id="report_action_cash_requirement" model="ir.actions.report">
        <field name="name">Cash Requirement Report</field>
        <field name="model">cash.requirement.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounts_extended.report_cash_requirement_document</field>
        <field name="report_file">accounts_extended.report_cash_requirement_document</field>
        <field name="paperformat_id" ref="accounts_extended.paperformat_a4_portrait_custom"/>
        <field name="print_report_name">'Cash Requirement Report'</field>
        <field name="binding_model_id" ref="accounts_extended.model_cash_requirement_report"/>
        <field name="binding_type">report</field>
