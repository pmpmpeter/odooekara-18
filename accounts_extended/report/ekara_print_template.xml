<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="template_print_invoice">
           <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <style>
                                div{
                                page-break-inside:avoid;
                                }
                                table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 13px;
                                font-family: Arial, sans-serif;
                                border: 1px solid #000000;
                                }

                                th, td {
                                border: 1px solid #000000;
                                page-break-inside:avoid;
                                text-align: left;
                                }
                                .title{
                                font-weight: bold;
                                }
                                .main-title{
                                font-weight: bold;
                                margin-top: 1px !important;
                                margin-bottom: -20px !important;
                                }
                                .watermark{
                                -webkit-transform: rotate(317deg);
                                -moz-transform: rotate(317deg);
                                -o-transform: rotate(317deg);
                                color: grey;
                                font-size: 9px;
                                font-family: Calibri,Candara,Segoe,Segoe UI,Optima,Arial,sans-serif;
                                }
                                .fill-line-container {
                                position: relative;
                                width: 80%;
                                margin: 0 auto;
                                }
                                .text-container {
                                position: relative;
                                margin-top: 20px;
                                }
                            </style>
                            <div style="font-weight:bold">
                                <h5>
                                    <center>
                                        <t t-if="o.move_type == 'out_invoice'">
                                            <b>TAX INVOICE</b>
                                        </t>
                                        <t t-if="o.move_type == 'in_invoice'">
                                            <b>BILL</b>
                                        </t>
                                    </center>
                                </h5>
                            </div>
                            <table style="width:100%">
                                <tr>
                                    <td width="20%" rowspan="2" style="border-right: hidden;font-size:15px;">
                                        <br/>
                                        <div class="logo" style="">
                                            <img t-if="o.company_id.logo" style="max-width:280px;max-height:90px;padding-left:10px;" t-att-src="image_data_uri(o.company_id.logo)" class="float-left" alt="Logo"/>
                                        </div>
                                    </td>
                                    <td rowspan="2" width="30%" style="padding-top:2px;">
                                        <div style="padding-top:2px;font-weight:bold;font-size:15px;">
                                            <t t-esc="o.company_id.name"/>
                                        </div>
                                        <t t-if="o.company_id.street">
                                            <div style="padding-top:2px;font-size:13px;">
                                                <t t-if="o.company_id.street and o.company_id.street2">
                                                    <t t-esc="o.company_id.street"/>,
                                                </t>
                                                <t t-if="o.company_id.street and not o.company_id.street2">
                                                    <t t-esc="o.company_id.street"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.company_id.street">
                                            <div style="padding-top:2px;font-size:13px;">
                                                <t t-if="o.company_id.city and o.company_id.city">
                                                    <t t-esc="o.company_id.street2"/>,
                                                </t>
                                                <t t-if="o.company_id.street and not o.company_id.city">
                                                    <t t-esc="o.company_id.street2"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.company_id.city or o.company_id.state_id.name or o.company_id.country_id.name">
                                            <div style="padding-top:2px;font-size:13px;">
                                                <t t-if="o.company_id.city and o.company_id.zip">
                                                    <t t-esc="o.company_id.city"/>
                                                    -
                                                </t>
                                                <t t-if="o.company_id.city and not o.company_id.zip">
                                                    <t t-esc="o.company_id.city"/>,
                                                </t>
                                                <t t-if="o.company_id.zip and o.company_id.state_id.name">
                                                    <t t-esc="o.company_id.zip"/>,
                                                </t>
                                                <t t-if="o.company_id.zip and not o.company_id.state_id.name">
                                                    <t t-esc="o.company_id.zip"/>
                                                </t>
                                                <t t-if="o.company_id.state_id.name and o.company_id.country_id.name">
                                                    <t t-esc="o.company_id.state_id.name"/>,
                                                </t>
                                                <t t-if="o.company_id.state_id.name and not o.company_id.country_id.name">
                                                    <t t-esc="o.company_id.state_id.name"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.company_id.country_id.name">
                                            <div style="padding-top:2px;font-size:13px;">
                                                <t t-if="o.company_id.country_id.name">
                                                    <t t-esc="o.company_id.country_id.name"/>
                                                </t>
                                            </div>
                                        </t>
                                        <div style="padding-top:2px;font-size:13px;">
                                            <t t-if="o.company_id.vat">GST#:
                                                <t t-esc="o.company_id.vat"/>
                                            </t>
                                        </div>
<!--                                        <div style="padding-top:2px;font-size:13px;">-->
<!--                                            <t t-if="o.company_id.drug_license">Drug License#:-->
<!--                                                <t t-esc="o.company_id.drug_license"/>-->
<!--                                            </t>-->
<!--                                        </div>-->
                                    </td>
                                    <td width="22%" style="line-height:normal;padding-left:2px;padding-top:2px;">
                                        <b>Invoice # &amp; Dt.</b><br/>
                                        <t t-esc="o.name"/>
                                        <t t-if="o.name and o.invoice_date">
                                            <div style="padding-left:35px;">&amp;<br/>
                                            </div>
                                        </t>
                                        <t t-if="o.invoice_date">
                                            <t t-esc="o.invoice_date" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MMM-yyyy&quot;}"/>
                                        </t>
                                    </td>
                                    <td width="28%" style="line-height:normal;padding-left:2px;padding-top:2px;">
                                        <b>Due Date</b>
                                        <t t-if="o.invoice_date_due">
                                            <br/>
                                            <t t-esc="o.invoice_date_due" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MMM-yyyy&quot;}"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="line-height:normal;padding-left:2px;padding-top:2px;">
                                        <b>Payment Reference</b>
                                            <t t-if="o.payment_reference">
                                                <br/>
                                                <t t-esc="o.payment_reference"/>
                                            </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" rowspan="2" style="padding-top:4px;padding-left:1px; margin-bottom:none;font-size:15px;">
                                        <b>Invoice To:</b>
                                        <t t-if="o.partner_shipping_id.name">
                                            <t t-esc="o.partner_shipping_id.name"/>
                                        </t>
                                        <t t-if="o.partner_shipping_id.street">
                                            <div style="padding-top:2px;">
                                                <t t-if="o.partner_shipping_id.street and o.partner_shipping_id.street2">
                                                    <t t-esc="o.partner_shipping_id.street"/>,
                                                </t>
                                                <t t-if="o.partner_shipping_id.street and not o.partner_shipping_id.street2">
                                                    <t t-esc="o.partner_shipping_id.street"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.partner_shipping_id.street2">
                                            <div style="padding-top:2px;">
                                                <t t-if="o.partner_shipping_id.city and o.partner_shipping_id.city">
                                                    <t t-esc="o.partner_shipping_id.street2"/>,
                                                </t>
                                                <t t-if="o.partner_shipping_id.street and not o.partner_shipping_id.city">
                                                    <t t-esc="o.partner_shipping_id.street2"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.partner_shipping_id.city or o.partner_shipping_id.state_id.name or o.partner_shipping_id.country_id.name">
                                            <div style="padding-top:2px;">
                                                <t t-if="o.partner_shipping_id.city and o.partner_shipping_id.zip">
                                                    <t t-esc="o.partner_shipping_id.city"/>
                                                    -
                                                </t>
                                                <t t-if="o.partner_shipping_id.city and not o.partner_shipping_id.zip">
                                                    <t t-esc="o.partner_shipping_id.city"/>,
                                                </t>
                                                <t t-if="o.partner_shipping_id.zip and o.partner_shipping_id.state_id.name">
                                                    <t t-esc="o.partner_shipping_id.zip"/>,
                                                </t>
                                                <t t-if="o.partner_shipping_id.zip and not o.partner_shipping_id.state_id.name">
                                                    <t t-esc="o.partner_shipping_id.zip"/>
                                                </t>
                                                <t t-if="o.partner_shipping_id.state_id.name and o.partner_shipping_id.country_id.name">
                                                    <t t-esc="o.partner_shipping_id.state_id.name"/>,
                                                </t>
                                                <t t-if="o.partner_shipping_id.state_id.name and not o.partner_shipping_id.country_id.name">
                                                    <t t-esc="o.partner_shipping_id.state_id.name"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="o.partner_shipping_id.country_id.name">
                                            <div style="padding-top:2px;">
                                                <t t-if="o.partner_shipping_id.country_id.name">
                                                    <t t-esc="o.partner_shipping_id.country_id.name"/>
                                                </t>
                                            </div>
                                        </t>
                                    </td>
                                    <td colspan="2" style="padding-left:1px;padding-top:4px;font-size:15px;">
                                        <b>Ship To:</b>
                                        <div style="padding-top:3px;">
                                            <t t-if="o.partner_id.parent_id and o.partner_id">
                                                <t t-esc="o.partner_id.parent_id.name"/>,
                                                <t t-esc="o.partner_id.name"/>
                                            </t>
                                            <t t-elif="o.partner_id.name">
                                                <t t-esc="o.partner_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="o.commercial_partner_id.name"/>
                                            </t>
                                            <t t-if="o.partner_id.street">
                                                <div style="padding-top:2px;">
                                                    <t t-if="o.partner_id.street and o.partner_id.street2">
                                                        <t t-esc="o.partner_id.street"/>,
                                                    </t>
                                                    <t t-if="o.partner_id.street and not o.partner_id.street2">
                                                        <t t-esc="o.partner_id.street"/>
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-if="o.partner_id.street">
                                                <div style="padding-top:2px;">
                                                    <t t-if="o.partner_id.city and o.partner_id.city">
                                                        <t t-esc="o.partner_id.street2"/>,
                                                    </t>
                                                    <t t-if="o.partner_id.street and not o.partner_id.city">
                                                        <t t-esc="o.partner_id.street2"/>
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-if="o.partner_id.city or o.partner_id.state_id.name or o.partner_id.country_id.name">
                                                <div style="padding-top:2px;">
                                                    <t t-if="o.partner_id.city and o.partner_id.zip">
                                                        <t t-esc="o.partner_id.city"/>
                                                        -
                                                    </t>
                                                    <t t-if="o.partner_id.city and not o.partner_id.zip">
                                                        <t t-esc="o.partner_id.city"/>,
                                                    </t>
                                                    <t t-if="o.partner_id.zip and o.partner_id.state_id.name">
                                                        <t t-esc="o.partner_id.zip"/>,
                                                    </t>
                                                    <t t-if="o.partner_id.zip and not o.partner_id.state_id.name">
                                                        <t t-esc="o.partner_id.zip"/>
                                                    </t>
                                                    <t t-if="o.partner_id.state_id.name and o.partner_id.country_id.name">
                                                        <t t-esc="o.partner_id.state_id.name"/>,
                                                    </t>
                                                    <t t-if="o.partner_id.state_id.name and not o.partner_id.country_id.name">
                                                        <t t-esc="o.partner_id.state_id.name"/>
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-if="o.partner_id.country_id.name">
                                                <div style="padding-top:2px;">
                                                    <t t-if="o.partner_id.country_id.name">
                                                        <t t-esc="o.partner_id.country_id.name"/>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                </tr>
                                <tr>
                                    <td colspan="12">
                                        <table class="table table-sm o_main_table" name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-start"><span>Description</span></th>
                                    <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                    <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                                    <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span>Disc.%</span>
                                    </th>
                                    <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                    <th name="th_subtotal" class="text-end">
                                        <span>Amount</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="current_total" t-value="0"/>
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                    <t t-set="current_total" t-value="current_total + line.price_total"/>

                                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                            <td name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                                            <td name="td_quantity" class="text-end">
                                                <span t-field="line.quantity">3.00</span>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                                            </td>
                                            <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                                            </td>
                                            <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span class="text-nowrap" t-field="line.discount">0</span>
                                            </td>
                                            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                            <td name="td_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
                                            </td>
                                            <td name="td_subtotal" class="text-end o_price_total">
                                                <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                                            </td>
                                        </t>
                                    </tr>

                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                        <tr class="is-subtotal text-end">
                                            <td colspan="99">
                                                <strong class="mr16">Subtotal</strong>
                                                <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}">31.05</span>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                               <tr>
                                    <td colspan="1" style="text-align:left; padding-left:1p;">
                                        <span>Amount in Words:</span>
                                        <small>
                                            <span t-field="o.amount_total_words"/>
                                        </small>
                                    </td>
                                    <td colspan="11" style="text-align:right; padding-right:1p;">
                                        <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                        <t t-foreach="tax_totals.get('subtotals')" t-as="subtotal">
                                            <div style="margin-bottom: 4px;">
                                                <strong t-out="subtotal['name']">Taxable Amount</strong>
                                                <span style="margin-left: 10px;" t-out="subtotal['formatted_amount']">27.00</span>
                                            </div>
                                            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
                                                <div style="margin-left: 20px;">
                                                    <span t-esc="amount_by_group['tax_group_name']"/>
                                                    <span t-if="not amount_by_group['hide_base_amount']" class="text-nowrap"> on
                                                        <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                                    </span>
                                                    :
                                                    <span class="text-nowrap" t-out="amount_by_group['formatted_tax_group_amount']">1.05</span>
                                                </div>
                                            </t>
                                        </t>

                                        <t t-if="'formatted_rounding_amount' in tax_totals and tax_totals.get('rounding_amount') != 0">
                                            <div style="margin-top: 4px;">
                                                <strong>Rounding:</strong>
                                                <span t-out="tax_totals.get('formatted_rounding_amount')">0</span>
                                            </div>
                                        </t>

                                        <div style="margin-top: 4px;">
                                            <strong>Total:</strong>
                                            <span t-out="tax_totals.get('formatted_amount_total')">31.05</span>
                                        </div>
                                    </td>
                                </tr>

                        </table>
                                    </td>
                                </tr>
                                <t t-if="o.company_id.partner_id.bank_ids">
                                    <tr>
                                        <td colspan="4" style="padding-left:1px;padding-bottom:0px;padding-top:2px;">
                                            <u>
                                                <b>Bank Details:</b>
                                            </u>
                                            <br/>
                                            <div style="padding-top:3px;font-size:14px;">
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.name">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.name"/>
                                                </t>
                                            </div>
                                            <div style="padding-top:2px;font-size:14px;">
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.street">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.street"/>
                                                </t>
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.street2">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.street2"/>
                                                </t>
                                            </div>
                                            <div style="padding-top:2px;font-size:14px;">
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.city">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.city"/>
                                                </t>
                                                <t t-if="o.company_id.partner_id.bank_ids.bank_id[0].city and o.company_id.partner_id.bank_ids[0].bank_id.zip">
                                                    -
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.zip"/>,
                                                </t>
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.state.name and o.company_id.partner_id.bank_ids[0].bank_id.country.name">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.state.name"/>,
                                                </t>
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.state.name and not o.company_id.partner_id.bank_ids[0].bank_id.state.name">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.state.name"/>
                                                </t>
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.country.name">
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.country.name"/>
                                                </t>
                                            </div>
                                            <div style="padding-top:2px;font-size:14px;">
                                                <t t-if="o.company_id.partner_id.bank_ids[0].acc_number">A/c No.:
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].acc_number"/>
                                                </t>  
                                                <t t-if="o.company_id.partner_id.bank_ids[0].bank_id.bic">SWIFT:
                                                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.bic"/>
                                                </t>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <!--<td colspan="2" style="padding-left:1px;padding-top:2px;border-right: hidden;line-height:normal;font-size:13px;">-->
                                    <!--    Declaration: We declare that this invoice shows the actual price of the Goods-->
                                    <!--    described and that all particulars are true and correct.-->
                                    <!--</td>-->
                                    <td colspan="12" style="text-align:right;padding-right:1px;padding-top:2px;font-size:14px;">
                                        <b>
                                            For <t t-esc="o.company_id.name"/>
                                        </b>
                                        <br/>
                                        <br/>Authorized Signatory
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
