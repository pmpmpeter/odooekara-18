<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_budget_code" model="ir.sequence">
        <field name="name">Budget Code</field>
        <field name="code">budget.code</field>
        <field name="prefix">BUDGET</field>
        <field name="padding">3</field>
    </record>

    <record id="seq_cash_pool_code" model="ir.sequence">
        <field name="name">Cash Pool Code</field>
        <field name="code">cash.pool</field>
        <field name="prefix">CP</field>
        <field name="padding">3</field>
    </record>

    <record id="seq_cash_requirement_report" model="ir.sequence">
        <field name="name">Cash Requirement Report</field>
        <field name="code">cash.requirement.report</field>
        <field name="prefix">CRR</field>
        <field name="padding">3</field>
    </record>
    <record id="seq_fund_management_code" model="ir.sequence">
        <field name="name">Fund Management Code</field>
        <field name="code">fund.management</field>
        <field name="prefix">FM</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
     <record id="seq_te_consolidation_code" model="ir.sequence">
        <field name="name">TE Consolidation Code</field>
        <field name="code">te.consolidation</field>
        <field name="prefix">TE</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>

    </record>
</odoo>
