<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_crr_reminder" model="ir.cron">
            <field name="name">CRR and CUR Monthly Reminder</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.send_crr_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(datetime.today().replace(day=20, hour=8, minute=0, second=0))"/>
        </record>

        <record id="ir_cron_recurring_payment" model="ir.cron">
            <field name="name">Recurring Payment </field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.action_create_recurring_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.today().replace(day=20, hour=8, minute=0, second=0))"/>
        </record>
        
    </data>
</odoo>
