<?xml version="1.0" ?>
<odoo>
    <record id="property_rule_hr_shift" model="ir.rule">
        <field name="name">Hr Insurancy Company</field>
        <field name="model_id" ref="model_hr_insurance"/>
        <field eval="True" name="global"/>
        <!-- <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>-->
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="property_rule_hr_shift_generate" model="ir.rule">
        <field name="name">Hr Insurance Policy company</field>
        <field name="model_id" ref="model_insurance_policy"/>
        <field eval="True" name="global"/>
        <!-- <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>-->
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="hr_insurance_see_own_record_user" model="ir.rule">
        <field name="name">See Own Insurance Record - User</field>
        <field name="model_id" ref="hr_insurance.model_hr_insurance"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grievance_management_see_all_records_user" model="ir.rule">
        <field name="name">See all Insurance Records - User</field>
        <field name="model_id" ref="hr_insurance.model_hr_insurance"/>
        <field name="domain_force">[(1 ,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="grievance_management_see_all_records" model="ir.rule">
        <field name="name">See all Insurance Records - Manager</field>
        <field name="model_id" ref="hr_insurance.model_hr_insurance"/>
        <field name="domain_force">[(1 ,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>
