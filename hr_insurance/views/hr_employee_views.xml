<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        hr employee form view inherited-->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherited.hr.insurance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <!--Client Want to hide this(march 19)-->
                <page name="insurance_ids" string="Insurance" groups="hr.group_hr_user" invisible="1">
                    <group>
                        <group>
                            <field name="insurance_percentage">%</field>
                        </group>
                        <group>
                            <field name="deduced_amount_per_year"/>
                            <field name="deduced_amount_per_month"/>
                        </group>
                    </group>
                    <field name="insurance_ids"
                           context="{'default_employee_id':id}"/>
                </page>
            </xpath>
        </field>
    </record>

     <record id="view_employee_insurance_form" model="ir.ui.view">
        <field name="name">view.employee.insurance.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-shield"
                        string="Insurance"
                        name="action_get_employee_insurance"
                        invisible="employee_insurance_count == 0">
                    <field name="employee_insurance_count" widget="statinfo" string="Insurance"/>
                </button>
            </div>
        </field>
    </record>
</odoo>