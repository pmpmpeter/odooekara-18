<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_h_report" model="ir.actions.report">
        <field name="name">Form - H</field>
        <field name="model">hr.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_attendance_extended.print_form_h</field>
        <field name="report_file">hr_attendance_extended.print_form_h</field>
        <field name="print_report_name">'Form H'</field>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="print_form_h">
            <t t-call="web.basic_layout">
                <t t-set="doc" t-value="doc or None" />
                <t t-call="web.external_layout">
                    <div>
                    </div>
                </t>
                <div class="page">
                    <br/>
                    <br/>
                    <p>
                        <t t-set="current_date" t-value="context_timestamp(datetime.datetime.now()).strftime('%B %Y')"/>
                        <t t-set="company_name" t-value="request.env['res.company'].sudo().search([('id','=',comp_id)])"/>
                        Form-H Report for <t t-esc="company_name.name"/> (<t t-esc="current_date"/>)<br/>
                        Location : <t t-esc="company_name.city"/> <br/>
                        Sub Location : <t t-esc="company_name.city"/>

                    </p>
                    <table style="width:100%; border-collapse: collapse;  font-size: 14px; ">
                        <tr style="font-weight: bold;">
                            <td colspan="20" style="text-align: center; vertical-align: middle; padding: 10px;">FORM H</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;"/>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td colspan="20" style="text-align: center; vertical-align: middle; padding: 10px;">(SEE RULE 9)</td>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td colspan="20" style="text-align: center; vertical-align: middle; padding: 10px;"> LEAVE WITH WAGES BOOK
                            </td>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Sl no</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Emp ID</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Emp Type</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">DOJ</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Employee Name</td>
                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Father's Name</td>
<!--                            <td rowspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Address</td>-->
                            <td colspan="11" style="text-align: center; vertical-align: middle; padding: 10px;">PART I EARNED LEAVE</td>
                            <td colspan="4" style="text-align: center; vertical-align: middle; padding: 10px;">PART II Sick Leave
                            </td>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td colspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">No of days worked</td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Leave earned</td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Leave at credit (incl balance if
                                any, on return from leave on last occasion
                            </td>
                            <td colspan="3" style="text-align: center; vertical-align: middle; padding: 10px;">Leave taken</td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Balance on return from leave
                            </td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Date on which wages for leave paid and amount paid
                            </td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Remarks</td>
                            <td colspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Sick/Accident leave</td>
                            <td rowspan="2" style="text-align: center; vertical-align: middle; padding: 10px;">Balance at the end of the year
                            </td>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">From</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">To</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">Total days worked</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">From</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">To</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">No. of days</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">Of Credi</td>
                            <td style="text-align: center; vertical-align: middle; padding: 10px;">Availed</td>
                        </tr>
                        <t t-set="count" t-value="1"/>
                        <t t-set="start_datetime" t-value="start_date + ' 00:00:00'"/>
                        <t t-set="end_datetime" t-value="end_date + ' 23:59:59'"/>
                       <t t-set="employee" t-value="request.env['hr.employee'].sudo().search([])"/>
                        <t t-set="current_year" t-value="context_timestamp(datetime.datetime.now()).strftime('%Y')"/>
                        <t t-foreach="employee" t-as="emp">
                             <t t-set="overall_leaves" t-value="0.0"/>
                            <t t-set="leaves_earned" t-value="0.0"/>
                            <t t-set="contract_id" t-value="emp.contract_id"/>
                            <t t-set="days" t-value="0"/>
                            <t t-set="attendance" t-value="request.env['hr.attendance'].sudo().search([('employee_id','=',emp.id),('check_in','&gt;=',start_datetime),('check_in','&lt;=',end_datetime)])"/>
                            <t t-if="attendance">
                                <t t-if="contract_id">
                                     <t t-foreach="attendance" t-as="rec">
                                         <t t-set="days" t-value="round(days + (rec.worked_hours / contract_id.resource_calendar_id.hours_per_day), 2)"/>
                                            <t t-if="contract_id.resource_calendar_id.full_time_required_hours == 40.00">
                                                <t t-set="leaves_earned" t-value="1.75"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="leaves_earned" t-value="1.95"/>
                                            </t>
                                    </t>
                                </t>

                            </t>
                            <t t-set="leaves_initial" t-value="request.env['hr.leave.allocation'].sudo().search([('employee_id','=',emp.id),('state','=','validate'),('date_from','&gt;=',start_date),('date_from','&lt;=',end_date)])"/>
                            <t t-foreach="leaves_initial" t-as="leaves">
                                <t t-set="overall_leaves" t-value="overall_leaves+leaves.number_of_days_display"/>
                            </t>
                            <t t-set="total_taken_leaves" t-value="0.0"/>
                            <t t-set="taken_leaves" t-value="request.env['hr.leave'].sudo().search([('employee_id','=',emp.id),('state','=','validate'),('request_date_from','&gt;=',start_date),('request_date_to','&lt;=',end_date)])"/>
                             <t t-foreach="taken_leaves" t-as="rec">
                                <t t-set="total_taken_leaves" t-value="total_taken_leaves + rec.number_of_days_display"/>
                            </t>
                            <t t-set="total_allocated_sick_leaves" t-value="0.0"/>
                            <t t-set="timeoff_taken" t-value="0.0"/>
                            <t t-set="sick_leave" t-value="request.env['hr.leave.allocation'].sudo().search([('employee_id','=',emp.id),('holiday_status_id','=','Sick Time Off'),('state','=','validate'),('date_from','&gt;=',start_date),('date_from','&lt;=',end_date)])"/>
                            <t t-set="sick_leave_taken" t-value="request.env['hr.leave'].sudo().search([('employee_id','=',emp.id),('holiday_status_id.name','=','Sick Time Off'),('state','=','validate'),('request_date_from','&gt;=',start_date),('request_date_to','&lt;=',end_date)])"/>
                            <t t-foreach="sick_leave" t-as="sick_leaves">
                                <t t-set="total_allocated_sick_leaves" t-value="total_allocated_sick_leaves + sick_leaves.number_of_days_display"/>
                            </t>
                            <t t-foreach="sick_leave_taken" t-as="sick_leaves">
                                <t t-set="timeoff_taken" t-value="timeoff_taken + sick_leaves.number_of_days_display"/>
                            </t>

                            <tr>
                            <td style="text-align: center;  padding: 10px; height: 70px;">
                                <t t-esc="count"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-esc="emp.employee_number"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="emp.employee_type"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-esc="emp.joining_date" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="emp.name"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="emp.father_name"/>
                            </td>
<!--                            <td style="text-align: center;  padding: 10px;height: 70px;">-->

<!--                            </td>-->
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-esc="start_date" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="end_date" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="round(days,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-esc="round(leaves_earned,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="round(overall_leaves,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-foreach="taken_leaves" t-as="rec">
                                    <t t-esc="rec.date_from" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/>
                                    <br/>
                                    <br/>
                                    <br/>
                                </t>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-foreach="taken_leaves" t-as="rec">
                                    <t t-esc="rec.date_to" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/>
                                     <br/>
                                     <br/>
                                     <br/>
                                </t>

                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-foreach="taken_leaves" t-as="rec">
                                    <t t-esc="round(rec.number_of_days_display,2)"/>
                                     <br/>
                                     <br/>
                                     <br/>
                                      <br/>
                                     <br/>
                                </t>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                 <t t-esc="round(overall_leaves-total_taken_leaves,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">

                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">

                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                              <t t-esc="round(total_allocated_sick_leaves,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                                <t t-esc="round(timeoff_taken,2)"/>
                            </td>
                            <td style="text-align: center;  padding: 10px;height: 70px;">
                               <t t-esc="round(total_allocated_sick_leaves - timeoff_taken,2)"/>
                            </td>
                        </tr>
                            <t t-set="count" t-value="count+1"/>
                        </t>
                    </table>



                </div>
        </t>
    </template>
</odoo>
