<odoo>
    <record id="view_attendance_report_wizard" model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Report">
                <group>
                    <field name="report_type"/>
                    <field name="company_id" options="{'no_open':True,'no_quick_create':True,'no_create': True,}"
                           readonly="1"/>
                    <field name="start_date" invisible="report_type == 'form_t'" required="0"/>
                    <field name="end_date" invisible="report_type == 'form_t'" required="0"/>
                    <field name="month" invisible="report_type != 'form_t'"/>
                    <field name="year" invisible="report_type != 'form_t'" readonly="1"/>
                </group>
                <footer>
                    <button name="generate_pdf_report" string="Download PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
