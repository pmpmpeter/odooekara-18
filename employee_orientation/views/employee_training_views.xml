<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Tree view of employee training-->
    <record id="employee_training_view_tree" model="ir.ui.view">
        <field name="name">employee.training.view.list</field>
        <field name="model">employee.training</field>
        <field name="arch" type="xml">
            <list string="Employee Training Program">
                <field name="program_name"/>
                <field name="program_department_id"/>
                <field name="program_convener_id"
                       domain="[('department_id.name', '=', 'program_department.name')]"/>
                <field name="state" widget="badge" decoration-success="state == 'complete'"
                       decoration-danger="state == 'cancel'" decoration-info="state in ('confirm')"/>
            </list>
        </field>
    </record>
    <!--    Form view of employee training-->
    <record id="employee_training_view_form" model="ir.ui.view">
        <field name="name">employee.training.view.form</field>
        <field name="model">employee.training</field>
        <field name="arch" type="xml">
            <form string="Employee Training Program">
                <header>
                    <button name="action_confirm_send_mail" groups="hr.group_hr_user"
                            string="Send by Email" type="object"
                            class="oe_highlight" invisible="state !='draft'"/>
                    <button name="action_confirm_event" string="Confirm Event" groups="hr.group_hr_user"
                            type="object" invisible="state !='new'"
                            class="btn-primary"/>
                    <button name="action_complete_event" string="Event Complete"
                            type="object" invisible="state !='confirm'" groups="hr.group_hr_user"
                            class="btn-primary"/>
                    <button name="action_cancel_event" string="Cancel Event" groups="hr.group_hr_user"
                            type="object" invisible="state !='confirm'"/>
                    <button name="print_event" string="Print Certificates" groups="hr.group_hr_user"
                            type="object" class="oe_highlight"
                            invisible="state !='complete'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,confirm,complete"/>
                </header>
                <sheet>
                    <group colspan="1" col="4" name="main">
                        <field name="company_id" invisible="1"/>
                        <field name="program_name" readonly="state not in ('new')"/>
                        <field name="program_department_id" readonly="state not in ('new')"
                               options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                        <label for="date_from" string="Time Period"/>
                        <div>
                            <field name="date_from" class="oe_inline" readonly="state not in ('new')"/>
                            to
                            <field name="date_to" class="oe_inline" readonly="state not in ('new')"/>
                        </div>
                        <field name="program_convener_id" readonly="state not in ('new')"
                               options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                    </group>
                    <notebook colspan="4">
                        <page name="checklist_lines" string="Employee Details">
                            <field name="training_ids" readonly="state not in ('new')">
                                <list editable="bottom" create="0">
                                    <field name="name" readonly="1"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                    <field name="job_id" readonly="1"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                    <field name="parent_id" readonly="1"
                                           options="{'no_open': True, 'no_quick_create':True,'no_create': True,}"/>
                                    <field name="certificates"/>
                                </list>
                            </field>
                        </page>
                        <page name="note_book"
                              string="Notes">
                            <field name="note_id" colspan="4" nolabel="1" readonly="state not in ('new')"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"
                           groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!--    Search view of employee training-->
    <record id="employee_training_view_search" model="ir.ui.view">
        <field name="name">employee.training.view.search</field>
        <field name="model">employee.training</field>
        <field name="arch" type="xml">
            <search string="Employee Training Program">
                <field name="program_name"/>
                <newline/>
            </search>
        </field>
    </record>
    <!--    Action of employee training-->
    <record model="ir.actions.act_window" id="employee_training_action">
        <field name="name">Employee Training Program</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.training</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="employee_training_view_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <field class="oe_view_nocontent_create">
                Create Employee Training Program.
            </field>
        </field>
    </record>
    <menuitem
            id="menu_employee_training_root"
            name="Training"
            parent="hr.menu_hr_employee_payroll"
            sequence="14"
    />
    <menuitem
            id="menu_employee_training_child"
            name="Training Program"
            parent="employee_orientation.menu_employee_training_root"
            action="employee_training_action"
            sequence="1"
    />
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.employee.orientation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="certificates"/>
            </xpath>
        </field>
    </record>
</odoo>
