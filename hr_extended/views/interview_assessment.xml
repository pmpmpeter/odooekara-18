<?xml version="1.0" ?>
<odoo>
    <record id="view_interview_assessment_form" model="ir.ui.view">
        <field name="name">interview.assessment.form</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <form string="Interview Assessment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    <button name="action_submit" type="object" class="btn-primary"
                            string="Submit" invisible="state in ('done')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state in ('draft')"/>
                    <button string="Print" type="action" invisible="state in ('draft')"
                            name="%(hr_extended.interview_assessment_template)d"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" string="Applicant"
                                name="action_open_applicant_record" icon="fa-user">
                        </button>
                    </div>
                    <group>
                        <group string="Candidate Information">
                            <field name="applicant_id" required='1'
                                   readonly="state not in ('draft')"
                                   options="{'no_open':True,'no_quick_create':True,'no_create': True,}"/>
                            <field name="name" required='1' readonly="state not in ('draft')"/>
                            <field name="position_interviewed_for" readonly="state not in ('draft')"/>
                            <field name="date_of_interview" readonly="state not in ('draft')"/>
                            <field name="nature_of_employment"
                                   options="{'no_open':True,'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="start_time" readonly="state not in ('draft')"/>
                            <field name="end_time" readonly="state not in ('draft')"/>
                        </group>
                        <group string="Current Employment">
                            <field name="present_company" readonly="state not in ('draft')"/>
                            <field name="present_designation" readonly="state not in ('draft')"/>
                            <field name="total_experience" readonly="state not in ('draft')"/>
                            <field name="relevant_experience" readonly="state not in ('draft')"/>
                        </group>
                        <group string="Salary &amp; Expectations">
                            <field name="education_qualifications" readonly="state not in ('draft')"/>
                            <field name="notice_period" readonly="state not in ('draft')"/>
                            <field name="current_ctc" readonly="state not in ('draft')"/>
                            <field name="expected_ctc" readonly="state not in ('draft')"/>
                        </group>
                        <group string="Interview Result / Feedback">
                            <field name="interview_result" widget="radio" readonly="state not in ('draft')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rating Scale">
                            <group string="Skill Rating">
                                <group>
                                    <field name="education_qualification_skills" readonly="state not in ('draft')"/>
                                    <field name="interpersonal_skills" readonly="state not in ('draft')"/>
                                    <field name="personality" readonly="state not in ('draft')"/>
                                    <field name="comprehension_analytical_ability" readonly="state not in ('draft')"/>
                                </group>
                                <group>
                                    <field name="relevance_of_experience" readonly="state not in ('draft')"/>
                                    <field name="job_product_technical_knowledge" readonly="state not in ('draft')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Interviewer’s Comments">
                            <group>
                                <group string="Functional">
                                    <field name="functional_comments" readonly="state not in ('draft')"/>
                                    <field name="hr_comments" readonly="state not in ('draft')"/>
                                </group>
                                <group string="Functional">
                                    <field name="position_offered"
                                           options="{'no_open':True,'no_quick_create':True,'no_create': True,}"
                                           readonly="state not in ('draft')"/>
                                    <field name="division" readonly="state not in ('draft')"/>
                                    <field name="grade_level" readonly="state not in ('draft')"/>
                                    <field name="ctc_recommended" readonly="state not in ('draft')"/>
                                    <field name="expected_date_of_joining" readonly="state not in ('draft')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Final Comments by the Panel">
                            <field name="panel_comments_ids" readonly="state not in ('draft')">
                                <list editable="bottom">
                                    <field name="panel_member_name"/>
                                    <field name="panel_member_designation"/>
                                    <field name="panel_member_department"/>
                                    <field name="final_comments"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_interview_assessment_tree" model="ir.ui.view">
        <field name="name">interview.assessment.list</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <list string="Interview Assessments">
                <field name="name"/>
                <field name="position_interviewed_for"/>
                <field name="date_of_interview"/>
                <field name="present_company"/>
                <field name="total_experience"/>
                <field name="relevant_experience"/>
                <field name="current_ctc"/>
                <field name="expected_ctc"/>
                <field name="state" widget='badge' decoration-info="state == 'draft'"
                       decoration-success="state =='done'"/>
            </list>
        </field>
    </record>

    <record id="view_interview_assessment_search" model="ir.ui.view">
        <field name="name">interview.assessment.search</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <search string="Interview Assessments">
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <field name="name"/>
                <!-- Filters -->
                <filter string="Interviewed Position" name="position_filter"
                        domain="[('position_interviewed_for', '!=', False)]"/>
                <filter string="Current Employment" name="current_employment_filter"
                        domain="[('present_company', '!=', False)]"/>
                <filter string="Pending Feedback" name="pending_feedback_filter"
                        domain="[('interview_result', '=', False)]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Position" name="group_by_position"
                            context="{'group_by': 'position_interviewed_for'}"/>
                    <filter string="Date of Interview" name="group_by_date"
                            context="{'group_by': 'date_of_interview'}"/>
                    <filter string="Company" name="group_by_company"
                            context="{'group_by': 'present_company'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_interview_assessment" model="ir.actions.act_window">
        <field name="name">Interview Assessments</field>
        <field name="res_model">interview.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Interview Assessment!
            </p>
        </field>
        <field name="context">{ 'search_default_done': 1 }</field>
    </record>


    <menuitem
            id="menu_interview_assessment_form"
            name="Interview Assessment"
            parent="hr_recruitment.menu_crm_case_categ0_act_job"
            action="action_interview_assessment"
            groups="hr.group_hr_user"
            sequence='3'/>
</odoo>
