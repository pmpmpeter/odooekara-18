<?xml version="1.0"?>
<odoo>
    <record id="employee_joining_doc_config_form_view" model="ir.ui.view">
        <field name="name">employee.join.doc.config.form</field>
        <field name="model">employee.join.doc.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="True"/>
                            <field name="document_type" required="True"/>
                            <field name="active"/>
                            <field name="sequence" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_open':True, 'no_quick_create':True,'no_create': True,}"/>
                            <field name="contact_id"
                                   invisible="document_type not in ('it_declaration','ebp_claim','bgv', 'epf')"
                                   options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Subject">
                                <field name="subject" placeholder="Enter Subject Here....."/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="employee_joining_doc_config_tree_view" model="ir.ui.view">
        <field name="name">view.kra.master.list</field>
        <field name="model">employee.join.doc.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="employee_joining_doc_config_search_view" model="ir.ui.view">
        <field name="name">view.kra.master.form.search</field>
        <field name="model">employee.join.doc.config</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
           
                <field name="name"/>
                <field name="document_type"/>
            </search>
        </field>
    </record>

    <record id="employee_joining_doc_config_action" model="ir.actions.act_window">
        <field name="name">Joining Doc Configuration</field>
        <field name="res_model">employee.join.doc.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="employee_joining_doc_config_tree_view"/>
        <field name="search_view_id" ref="employee_joining_doc_config_search_view"/>
    </record>

    <menuitem id="menu_joining_document" name="Joining Document" parent="hr.menu_human_resources_configuration"
              sequence="4" groups="hr.group_hr_manager"/>

    <menuitem id="menu_hr_recruitment_joining_doc" name="Joining Document Configuration"
              parent="hr_extended.menu_joining_document"
              action="employee_joining_doc_config_action" sequence="2"/>
</odoo>
