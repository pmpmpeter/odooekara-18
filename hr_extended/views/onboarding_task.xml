<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_onboarding_task_tree" model="ir.ui.view">
            <field name="name">onboarding.task.list</field>
            <field name="model">onboarding.task</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_onboarding_task_form" model="ir.ui.view">
            <field name="name">onboarding.task.form</field>
            <field name="model">onboarding.task</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_onboarding_task" model="ir.actions.act_window">
            <field name="name">Onboarding Tasks</field>
            <field name="res_model">onboarding.task</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_create">
                    Create your onboarding tasks here.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_onboarding_task"
                  name="Onboarding Tasks"
                  parent="hr.menu_config_recruitment"
                  action="action_onboarding_task"
                  sequence="12"/>
    </data>
</odoo>
