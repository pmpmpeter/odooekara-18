<?xml version="1.0"?>
<odoo>
    <data>
        <record id="survey_survey_view_form_inherit" model="ir.ui.view">
            <field name="name">survey.survey.view.form.inherit</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="start_date"/>
                    <field name="end_date"/>
                </xpath>
            </field>
        </record>
    
        <record id="survey_user_input_view_graph" model="ir.ui.view">
            <field name="name">survey.user_input.view.graph</field>
            <field name="model">survey.user_input</field>
            <field name="arch" type="xml">
                <graph string="Survey Results" type="bar">
                    <field name="state" type="row"/>
                    <field name="scoring_percentage" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="survey_user_input_view_pie" model="ir.ui.view">
            <field name="name">survey.user_input.view.pie</field>
            <field name="model">survey.user_input</field>
            <field name="arch" type="xml">
                <graph string="Survey Results" type="pie">
                    <field name="state" type="row"/>
                    <field name="scoring_percentage" type="measure"/>
                </graph>
            </field>
        </record>
        <record model="ir.actions.act_window" id="survey.action_survey_user_input">
            <field name="name">Participations</field>
            <field name="res_model">survey.user_input</field>
            <field name="view_mode">list,kanban,form,graph</field>
            <field name="view_id" ref="survey.survey_user_input_view_tree"/>
            <field name="search_view_id" ref="survey.survey_user_input_view_search"/>
            <field name="context">{'search_default_group_by_survey': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No answers yet!
                </p>
                <p>
                    You can share your links through different means: email, invite shortcut, live presentation, ...
                </p>
            </field>
        </record>

        <record id="survey_question_form_inherit" model="ir.ui.view">
            <field name="name">survey.question.view.form.inherit</field>
            <field name="model">survey.question</field>
            <field name="inherit_id" ref="survey.survey_question_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_page']" position="after">
                    <field name="is_default_question" invisible="1"/>
                </xpath>
            </field>
        </record>
        <record model="ir.actions.act_window" id="survey.action_survey_question_form">
            <field name="name">Questions</field>
            <field name="res_model">survey.question</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="survey.survey_question_search"/>
            <field name="context">{'search_default_group_by_page': True, 'show_survey_field': True}</field>
            <field name="domain">[('is_page', '=', False),('is_default_question','=',False)]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_empty_folder">
                No Questions yet!
              </p><p>
                Come back once you have added questions to your Surveys.
              </p>
            </field>
        </record>
        <record model="ir.ui.view" id="survey_question_tree_custom">
            <field name="name">List view for survey question</field>
            <field name="model">survey.question</field>
            <field name="arch" type="xml">
                <list string="Survey Question">
                    <field name="title"/>
                    <field name="survey_id"/>
                    <field name="question_type"/>
                    <field name="constr_mandatory" optional="1"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_survey_question_form_custom">
            <field name="name">Questions</field>
            <field name="res_model">survey.question</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="survey_question_tree_custom"/>
            <field name="search_view_id" ref="survey.survey_question_search"/>
            <field name="context">{'search_default_group_by_page': True, 'show_survey_field': True}</field>
            <field name="domain">[('is_page', '=', False),('is_default_question','=',True)]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_empty_folder">
                No Questions yet!
              </p><p>
                Come back once you have added questions to your Surveys.
              </p>
            </field>
        </record>
        <menuitem name="Questions Master" id="menu_survey_question_form11" action="action_survey_question_form_custom" parent="survey.survey_menu_questions" sequence="2"/>
    </data>
</odoo>
