<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- HR Job Levels -->

        <record id="hr_job_levels_view_tree" model="ir.ui.view">
            <field name="model">hr.job.levels</field>
            <field name="arch" type="xml">
                <list string="Job Levels" editable="bottom" duplicate="0">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="company_id" options="{'no_open':True,'no_quick_create':True,'no_create': True,}"/>
                    <field name="code" groups="base.group_no_one"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="hr_job_level_view_form" model="ir.ui.view">
            <field name="model">hr.job.levels</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"
                                   options="{'no_open':True,'no_quick_create':True,'no_create': True,}"/>
                            <field name="code" groups="base.group_no_one"/>
                            <field name="active"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_job_level_search" model="ir.ui.view">
            <field name="name">Job Level Search</field>
            <field name="model">hr.job.levels</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <field name="name" string="Name"/>
                </search>
            </field>
        </record>

        <record id="hr_job_levels_action" model="ir.actions.act_window">
            <field name="name">Job Levels</field>
            <field name="res_model">hr.job.levels</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_job_level_search"/>
            <field name="target">current</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Job level
                </p>
            </field>
        </record>

        <menuitem
                id="menu_hr_recruitment_job_levels"
                action="hr_job_levels_action"
                parent="hr_recruitment.menu_hr_recruitment_config_jobs"
                sequence="3"
                groups="hr_recruitment.group_hr_recruitment_manager"/>

