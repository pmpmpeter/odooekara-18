<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_contract.action_hr_contract" model="ir.actions.act_window">
        <field name="name">Compensation Master</field>
    </record>

    <record id="hr_contract_salary.action_hr_contract_templates" model="ir.actions.act_window">
        <field name="name">Compensation Master Templates</field>
    </record>

    <record id="hr_contract_compensation_view_form" model="ir.ui.view">
        <field name="name">hr.contract.compensation.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_contract_list']" position="replace">
                <button name="action_open_contract_list"
                        class="oe_stat_button"
                        icon="fa-book"
                        type="object"
                        invisible="contracts_count == 0"
                        groups="hr_contract.group_hr_contract_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="contracts_count"/>
                        </span>
                        <span invisible="contracts_count == 1" class="o_stat_text">
                            Compensation Masters
                        </span>
                        <span invisible="contracts_count &gt; 1" class="o_stat_text">
                            Compensation Master
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="custom_hr_employee_view_form3" model="ir.ui.view">
        <field name="name">custom.hr.hr.employee.view.form3</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_contract.hr_hr_employee_view_form3"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='action_open_contract']" position="replace">
                    <button name="action_open_contract"
                            class="oe_stat_button"
                            icon="fa-book"
                            type="object"
                            groups="hr_contract.group_hr_contract_manager"
                            context="{'default_employee_id': id}"
                            invisible="employee_type not in ['employee', 'student', 'trainee']">
                        <div invisible="not first_contract_date" class="o_stat_info">
                            <span class="o_stat_text text-success" invisible="contract_warning"
                                  title="In Compensation Master Since">In Compensation Master Since
                            </span>
                            <span class="o_stat_value text-success" invisible="contract_warning">
                                <field name="first_contract_date" readonly="1"/>
                            </span>
                            <span class="o_stat_text text-danger" invisible="not contract_warning"
                                  title="In Compensation Master Since">
                                In Compensation Master Since
                            </span>
                            <span class="o_stat_value text-danger" invisible="not contract_warning">
                                <field name="first_contract_date" readonly="1"/>
                            </span>
                        </div>
                        <div invisible="first_contract_date" class="o_stat_info">
                            <span class="o_stat_value text-danger">
                                <field name="contracts_count"/>
                            </span>
                            <span invisible="contracts_count != 1" class="o_stat_text text-danger">
                                Compensation Master
                            </span>
                            <span invisible="contracts_count == 1" class="o_stat_text text-danger">
                                Compensation Masters
                            </span>
                        </div>
                    </button>
                </xpath>
            </data>
        </field>
    </record>

    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other']" position="attributes">
                <attribute name="string">Compensation Master Details</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_contract_view_tree_inherit" model="ir.ui.view">
        <field name="name">hr.contract.view.list.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(hr_payroll.action_hr_payroll_index)d" type="action"
                            string="Index Compensation Masters" groups="hr_contract.group_hr_contract_manager"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="resource_calendar_view_form_inherit" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.hr.contract</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_contracts']/field[@name='contracts_count']" position="attributes">
                <attribute name="string">Compensation Master</attribute>
            </xpath>
        </field>
    </record>

    <menuitem
            id="hr_contract.menu_human_resources_configuration_contract"
            name="Compensation Master"
            parent="hr.menu_human_resources_configuration"
            sequence="25"/>

    <menuitem
            id="hr_contract.hr_menu_contract"
            name="Compensation Master"
            action="hr_contract.action_hr_contract"
            parent="hr.menu_hr_employee_payroll"
            sequence="6"
            groups="hr_contract.group_hr_contract_manager"/>

    <menuitem id="hr_contract_reports.menu_report_contract_employee_all"
              name="Compensation Master"
              action="hr_contract_reports.contract_employee_report_action"
              parent="hr.hr_menu_hr_reports"
              groups="hr_contract.group_hr_contract_manager"
              sequence="1"/>

    <menuitem
            id="hr_payroll.menu_hr_payroll_employees_root"
            name="Compensation Master"
            parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
            sequence="50"/>

    <menuitem
            id="hr_payroll.hr_menu_all_contracts"
            name="Compensation Master"
            action="hr_contract.action_hr_contract"
            parent="hr_payroll.menu_hr_payroll_employees_root"
            sequence="30"/>

    <menuitem
            id="hr_contract_salary_payroll.menu_hr_payroll_configuration_contract"
            name="Compensation Master"
            parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
            sequence="25"/>

    <menuitem
            name="Leaves"
            id="hr_holidays.menu_hr_holidays_root"
            sequence="225"
            web_icon="hr_holidays,static/description/icon.png"
            groups="base.group_user"/>

    <record id="hr_leave_action_dynamic_server" model="ir.actions.server">
            <field name="name">Leaves: Self + Subordinates</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="state">code</field>
            <field name="code">
        action = model.get_dynamic_leave_action()
            </field>
     </record>

    <menuitem
            id="hr_holidays.menu_open_department_leave_approve"
            name="Leaves"
            parent="hr_holidays.menu_hr_holidays_management"
            action="hr_extended.hr_leave_action_dynamic_server"
            sequence="1"/>

    <menuitem
            id="hr_holidays.hr_holidays_status_menu_configuration"
            action="hr_holidays.open_view_holiday_status"
            name="Leave Types"
            parent="hr_holidays.menu_hr_holidays_configuration"
            groups="hr_holidays.group_hr_holidays_manager"
            sequence="1"/>

    <record id="hr_holidays.hr_leave_action_my" model="ir.actions.act_window">
        <field name="name">My Leaves</field>
    </record>

    <menuitem
            id="hr_holidays.hr_leave_menu_my"
            parent="hr_holidays.menu_hr_holidays_my_leaves"
            action="hr_holidays.hr_leave_action_my"
            name="My Leaves"
            sequence="2"/>

    <record id="hr_holidays.open_view_holiday_status" model="ir.actions.act_window">
        <field name="name">Leave Types</field>
    </record>


    <!-- Payroll Menus -->
    <menuitem
            id="hr_payroll.menu_hr_payroll_payslips"
            name="Payroll Input Sheet"
            parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
            sequence="70"
            groups="hr_payroll.group_hr_payroll_user,group_hr_payslip_readonly"/>

    <menuitem
            id="hr_payroll.menu_hr_payroll_employee_payslips"
            name="All Payroll Input Sheet"
            parent="hr_payroll.menu_hr_payroll_payslips"
            sequence="60"
            action="hr_payroll.action_view_hr_payslip_month_form"
            groups="hr_payroll.group_hr_payroll_user,group_hr_payslip_readonly"/>

    <record id="hr_payroll.hr_payslip_action_view_to_pay" model="ir.actions.act_window">
        <field name="name">Payroll Input Sheet to Pay</field>
    </record>

    <record id="hr_payroll.action_view_hr_payslip_form" model="ir.actions.act_window">
        <field name="name">Payroll Input Sheet</field>
    </record>

    <record id="hr_payroll.action_view_hr_payslip_month_form" model="ir.actions.act_window">
        <field name="name">Payroll Input Sheet</field>
    </record>

    <record id="hr_payroll.act_hr_employee_payslip_list" model="ir.actions.act_window">
        <field name="name">Payroll Input Sheet</field>
    </record>

    <record id="hr_payroll.action_hr_payslip_run_tree" model="ir.actions.act_window">
        <field name="name">Payroll Input Sheet Batches</field>
    </record>

    <record id="hr_payroll.action_hr_payslip_by_employees" model="ir.actions.act_window">
        <field name="name">Generate Payroll Input Sheets</field>
    </record>

    <record id="hr_payslip_run_button_rename_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.button.rename.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_payslips']" position="replace">
                <button name="action_open_payslips" class="oe_stat_button" icon="fa-book" type="object"
                        help="Generated Payslips" invisible="payslip_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="payslip_count"/>
                        </span>
                        <span class="o_stat_text">Payroll Input Sheet</span>
                    </div>
                </button>

            </xpath>
        </field>
    </record>

</odoo>
