    <record id="ir_rule_business_units_company" model="ir.rule">
        <field name="name">Business Units: Multi Company</field>
        <field name="model_id" ref="hr_extended.model_business_units"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
