    </record>
    <record id="group_view_own_accounting_comp" model="res.groups">
        <field name="name">Accounting:View Accounting Components</field>
    </record>

    <!-- Manager Group -->
    <record id="group_manpower_budget_manager" model="res.groups">
        <field name="name">Manpower Budget Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_manpower_budget_user'))]"/>
    </record>

