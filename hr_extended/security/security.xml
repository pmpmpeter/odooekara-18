    <record id="hr_employee_rule_hr" model="ir.rule">
        <field name="name">Employee HR</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="hr_employee_rule_manager" model="ir.rule">
        <field name="name">Employee Manager</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="group_hr_recruitment_bu_head" model="res.groups">
        <field name="name">BU Head</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="comment">This group has permissions to oversee the recruitment process for their business unit.
        </field>
    </record>

    <record id="group_hr_recruitment_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('hr_extended.group_hr_recruitment_bu_head'))]"/>
        <field name="comment">This group has permissions to oversee and manage recruitment at the organization-wide
            level.
        </field>
    </record>
    <record id="seq_manpower_budget" model="ir.sequence">
        <field name="name">Manpower Budget Sequence</field>
        <field name="code">manpower.budget</field>
        <field name="prefix">MPB-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
    <!-- User Group -->
    <record id="group_manpower_budget_user" model="res.groups">
        <field name="name">Manpower Budget User</field>
    </record>

    <record id="group_view_own_document" model="res.groups">
