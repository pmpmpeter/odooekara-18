     <record id="group_hr_payslip_readonly" model="res.groups">
            <field name="name">Payroll Readonly</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

     <record id="group_hr_payslip_admin" model="res.groups">
            <field name="name">HR - Admin</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
     </record>

    <record id="employee_indent_comp_rule" model="ir.rule">
        <field name="name">Employee Indent multi-company</field>
        <field name="model_id" ref="model_employee_indent"/>
        <field name="domain_force">[('organization', 'in', company_ids)]</field>
    </record>

    <record id="joining_doc_config_rule" model="ir.rule">
        <field name="name">Joining Documents multi-company</field>
        <field name="model_id" ref="model_employee_join_doc_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ir_rule_employee_kra_company" model="ir.rule">
        <field name="name">Employee KRA: Multi Company</field>
        <field name="model_id" ref="hr_extended.model_employee_kra"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ir_rule_joining_documents_company" model="ir.rule">
        <field name="name">Joining Documents: Multi Company</field>
        <field name="model_id" ref="hr_extended.model_joining_documents"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
