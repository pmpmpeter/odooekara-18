    <record id="offer_letter_mail" model="mail.template">
        <field name="name">Offer Letter Mail</field>
        <field name="model_id" ref="hr_extended.model_hr_applicant"/>
        <field name="email_to">{{object.email_from}}</field>
        <field name="subject">Offer Letter Mail
        </field>
        <field name="report_template_ids" eval="[(4, ref('hr_extended.salary_breakup_report'))]"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.partner_name "></t>
                    <br/>
                    <br/>
                    <br/>
                    We are pleased to inform you that your offer letter has been generated and is attached to this
                    email.
                    <br/>
                    Please review the attached offer letter document for further details regarding your employment with
                    <b>
                        <t t-out="object.company_id.name"/>
                    </b>
                    .
                    <br/>
                    <br/>
                    If you have any questions or require any clarifications, feel free to contact us.
                    <br/>
                    <br/>
                    <b>Best regards,</b>
                    <br/>
                    <t t-out="object.user_id.name"/>
                </p>
            </div>
        </field>
        <field name="lang">{{object.user_id.lang}}</field>
        <field name="auto_delete" eval="True"/>
    </record>

