<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_balance_leave_report_wizard_form" model="ir.ui.view">
            <field name="name">balance.leave.report.wizard.form</field>
            <field name="model">balance.leave.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Balance Leaves Report">
                    <group invisible="report_printed==True">
                        <group>
                            <field name="date_from" required='1'/>
                            <field name="date_to" required='1'/>
                        </group>
                        <group>
                            <field name="company_id" required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="report_printed" invisible="1"/>
                        <group invisible="report_printed==False">
                            <field name="file_name" invisible="1"/>
                            <field name="summary_file" readonly="1" filename="file_name"/>
                        </group>
                    </group>
                    <footer>
                        <button string='Download' name="action_get_balance_leave_report"
                                type="object" class="btn-primary" invisible="report_printed==True"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_balance_leave_report_wizard" model="ir.actions.act_window">
            <field name="name">Balance Leave Report</field>
            <field name="res_model">balance.leave.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="target">new</field>
        </record>


        <menuitem id="menu_balance_leave_report"
                  name="Balance Leave Report"
                  action="action_balance_leave_report_wizard"
                  parent="hr.menu_hr_root"
                  groups="hr.group_hr_manager"
                  sequence="10"/>


    </data>
</odoo>
