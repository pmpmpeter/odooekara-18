<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- First define the Paper Format -->
    <record id="balance_confirmation_doc_form_pdf_A4" model="report.paperformat">
        <field name="name">Balance Confirmation Template</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">48</field>
        <field name="dpi">90</field>
    </record>

    <!-- Then define the Report Action -->
    <record id="action_pdf_report_creation" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">generate.pdf.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ekara_pdf_report.report_balance_confirmation_pdf</field>
        <field name="report_file">ekara_pdf_report.report_balance_confirmation_pdf</field>
        <field name="paperformat_id" ref="ekara_pdf_report.balance_confirmation_doc_form_pdf_A4"/>
    </record>

</odoo>
